<%- include('partials/header') %>

<style>
  :root {
    --primary: <%= theme || "#a855f7" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.1);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ១. Background Neural ស្ងប់ស្ងាត់ */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.1;
    pointer-events: none;
  }

  /* ២. Layout ពុះជាពីរ (Split Screen) */
  .register-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .main-auth-card {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 1200px;
    min-height: 750px;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(20px);
    border-radius: 40px;
    border: 1px solid var(--border-light);
    overflow: hidden;
    box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.6);
  }

  @media (min-width: 1024px) {
    .main-auth-card {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  /* ផ្នែកខាងឆ្វេង៖ រូបភាព និង Promote Text */
  .auth-visual-side {
    position: relative;
    background:
      linear-gradient(rgba(15, 23, 42, 0.5), rgba(15, 23, 42, 0.5)),
      url("/images/2.png"); /* រក្សាស្ទីលដូច Login */
    background-size: cover;
    background-position: center;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .promote-box {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(10px);
    padding: 35px;
    border-radius: 30px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ផ្នែកខាងស្តាំ៖ Form ចុះឈ្មោះ */
  .auth-form-side {
    padding: 40px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: rgba(30, 41, 59, 0.2);
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  /* ៣. Input & Strength Meter Styles */
  .input-custom {
    background: rgba(15, 23, 42, 0.6) !important;
    border: 1px solid var(--border-light) !important;
    color: white !important;
    padding: 1rem 1.4rem !important;
    border-radius: 18px !important;
    width: 100%;
    outline: none;
    transition: all 0.3s ease;
  }
  .input-custom:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.15);
  }

  .strength-bar-bg {
    height: 5px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    margin-top: 10px;
    overflow: hidden;
  }
  .strength-bar {
    height: 100%;
    width: 0%;
    transition: all 0.5s ease;
  }

  .btn-register-custom {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: 800;
    padding: 1.1rem;
    border-radius: 18px;
    width: 100%;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 10px 20px -5px rgba(168, 85, 247, 0.3);
  }

  .btn-google {
    background: white;
    color: #1e293b;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 1rem;
    border-radius: 18px;
    width: 100%;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }

  @media (max-width: 1024px) {
    .main-auth-card {
      grid-template-columns: 1fr;
      border-radius: 24px;
    }
    .auth-visual-side {
      display: none;
    }
    .auth-form-side {
      padding: 40px 20px;
    }
  }
</style>

<canvas id="neural-bg"></canvas>

<div class="register-wrapper">
  <main class="main-auth-card animate-in fade-in zoom-in duration-700">
    <section class="auth-visual-side">
      <div class="promote-box">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/20 border border-purple-500/30 mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          <span
            class="text-purple-300 text-[10px] font-bold uppercase tracking-widest"
            >New Identity Protocol</span
          >
        </div>
        <h2
          class="text-4xl md:text-5xl font-black text-white mb-4 uppercase leading-tight"
        >
          ចាប់ផ្តើមជាមួយ AI
        </h2>
        <p class="text-lg text-slate-200 font-light leading-relaxed">
          "បង្កើតគណនីតែមួយ ប្រើប្រាស់មន្តអាគម AI បានគ្រប់ទីកន្លែង! វានឹងក្លាយជា
          <span class="text-purple-400 font-bold">ខួរក្បាលទី២</span> របស់ប្អូន
          ដើម្បីរក្សាទុករាល់ការចងចាំសំខាន់ៗ។"
        </p>
        <div class="flex gap-6 mt-8">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🌍</span>
            <span
              class="text-[10px] font-bold text-slate-300 uppercase tracking-tighter"
              >Sync All Devices</span
            >
          </div>
          <div class="flex items-center gap-3">
            <span class="text-2xl">🛡️</span>
            <span
              class="text-[10px] font-bold text-slate-300 uppercase tracking-tighter"
              >Secure Storage</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="auth-form-side">
      <div class="w-full max-w-md mx-auto">
        <div class="text-center mb-10">
          <h1 class="text-3xl font-extrabold shimmer-text uppercase">
            បង្កើតគណនី
          </h1>
          <p class="text-slate-500 text-sm mt-2 italic">
            សូមបំពេញព័ត៌មាន ដើម្បីចាប់ផ្ដើមបេសកកម្ម
          </p>
        </div>

        <div class="space-y-6">
          <button
            onclick="signInWithGoogle()"
            id="googleBtn"
            class="btn-google"
          >
            <img
              src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
              class="w-5 h-5"
              alt="Google"
            />
            <span>ចុះឈ្មោះតាម Google</span>
          </button>

          <div class="flex items-center gap-3 py-1">
            <div class="h-px flex-1 bg-white/5"></div>
            <span
              class="text-[10px] text-slate-600 uppercase font-black tracking-widest"
              >ឬ ប្រើអ៊ីមែល</span
            >
            <div class="h-px flex-1 bg-white/5"></div>
          </div>

          <div class="space-y-4">
            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase ml-1"
                >អាសយដ្ឋានអ៊ីមែល</label
              >
              <input
                type="email"
                id="email"
                class="input-custom"
                placeholder="name@example.com"
              />
            </div>

            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase ml-1"
                >លេខសម្ងាត់</label
              >
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  oninput="checkStrength(this.value)"
                  class="input-custom"
                  placeholder="យ៉ាងតិច ៨ ខ្ទង់"
                />
                <button
                  onclick="togglePass('password')"
                  class="absolute right-4 top-1/2 -translate-y-1/2 opacity-40 hover:opacity-100"
                >
                  <span id="eye-1">👁️</span>
                </button>
              </div>
              <div class="px-1">
                <div class="strength-bar-bg">
                  <div id="meter" class="strength-bar"></div>
                </div>
                <div class="flex justify-between mt-1.5">
                  <span
                    id="strengthText"
                    class="text-[9px] font-bold uppercase text-slate-600"
                    >កម្រិតសុវត្ថិភាព</span
                  >
                  <span
                    id="strengthPercent"
                    class="text-[9px] font-mono text-slate-500"
                    >0%</span
                  >
                </div>
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="text-[10px] font-bold text-slate-500 uppercase ml-1"
                >បញ្ជាក់លេខសម្ងាត់</label
              >
              <div class="relative">
                <input
                  type="password"
                  id="confirmPassword"
                  class="input-custom"
                  placeholder="បញ្ចូលលេខសម្ងាត់ម្តងទៀត"
                />
                <button
                  onclick="togglePass('confirmPassword')"
                  class="absolute right-4 top-1/2 -translate-y-1/2 opacity-40 hover:opacity-100"
                >
                  <span id="eye-2">👁️</span>
                </button>
              </div>
            </div>
          </div>

          <button
            onclick="handleRegister()"
            id="regBtn"
            class="btn-register-custom mt-4"
          >
            បង្កើតគណនីឥឡូវនេះ
          </button>

          <p class="text-center text-sm text-slate-500 mt-8">
            មានគណនីរួចហើយ?
            <a
              href="/login"
              class="text-purple-400 font-bold hover:underline ml-1"
              >ចូលប្រើប្រាស់វិញ</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>
</div>

<%- include('partials/footer') %>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import {
    getAuth,
    createUserWithEmailAndPassword,
    GoogleAuthProvider,
    signInWithPopup,
  } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "<%= firebaseConfig.apiKey %>",
    authDomain: "<%= firebaseConfig.authDomain %>",
    projectId: "<%= firebaseConfig.projectId %>",
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // ១. Background Animation (រង្វើល និងយឺត)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 40; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#a855f7' %>";
    ctx.strokeStyle = "rgba(255, 255, 255, 0.03)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 150) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. UI Logic (Toggle Eye & Strength Meter)
  window.togglePass = (id) => {
    const input = document.getElementById(id);
    const eye =
      id === "password"
        ? document.getElementById("eye-1")
        : document.getElementById("eye-2");
    if (input.type === "password") {
      input.type = "text";
      eye.innerText = "🔒";
    } else {
      input.type = "password";
      eye.innerText = "👁️";
    }
  };

  window.checkStrength = (pass) => {
    const meter = document.getElementById("meter");
    const text = document.getElementById("strengthText");
    const percent = document.getElementById("strengthPercent");
    let strength = 0;
    if (pass.length >= 8) strength += 25;
    if (pass.match(/[A-Z]/)) strength += 25;
    if (pass.match(/[0-9]/)) strength += 25;
    if (pass.match(/[^A-Za-z0-9]/)) strength += 25;

    meter.style.width = strength + "%";
    percent.innerText = strength + "%";

    if (strength <= 25) {
      meter.style.backgroundColor = "#ef4444";
      text.innerText = "ខ្សោយពេក";
      text.style.color = "#ef4444";
    } else if (strength <= 75) {
      meter.style.backgroundColor = "#f59e0b";
      text.innerText = "មធ្យម";
      text.style.color = "#f59e0b";
    } else {
      meter.style.backgroundColor = "#10b981";
      text.innerText = "រឹងមាំខ្លាំង";
      text.style.color = "#10b981";
    }
  };

  // ៣. Auth Actions
  window.signInWithGoogle = async () => {
    const btn = document.getElementById("googleBtn");
    btn.innerHTML = "<span>កំពុងតភ្ជាប់...</span>";
    try {
      const result = await signInWithPopup(auth, provider);
      await sendTokenToBackend(result.user);
    } catch (error) {
      btn.innerHTML = `<span>ចុះឈ្មោះតាម Google</span>`;
      Swal.fire({
        text: "ការតភ្ជាប់បរាជ័យ!",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }
  };

  window.handleRegister = async () => {
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;
    const confirmPassword = document.getElementById("confirmPassword").value;
    const btn = document.getElementById("regBtn");

    if (!email || !password)
      return Swal.fire({
        text: "បំពេញឱ្យគ្រប់សិនបងប្រូ!",
        icon: "warning",
        confirmButtonColor: "#a855f7",
      });
    if (password !== confirmPassword)
      return Swal.fire({
        text: "លេខសម្ងាត់ទាំងពីរមិនដូចគ្នាទេ!",
        icon: "error",
      });

    btn.innerText = "កំពុងបង្កើតគណនី...";
    btn.classList.add("pointer-events-none", "opacity-70");

    try {
      const result = await createUserWithEmailAndPassword(
        auth,
        email,
        password,
      );
      await sendTokenToBackend(result.user);
    } catch (error) {
      btn.innerText = "បង្កើតគណនីឥឡូវនេះ";
      btn.classList.remove("pointer-events-none", "opacity-70");
      Swal.fire({
        text: "អ៊ីមែលនេះមានគេប្រើរួចហើយ ឬមានបញ្ហាបច្ចេកទេស!",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }
  };

  async function sendTokenToBackend(user) {
    const idToken = await user.getIdToken();
    const res = await fetch("/api/auth/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ idToken, isRegistering: true }),
    });
    if (res.ok) window.location.href = "/dashboard";
    else Swal.fire({ text: "មានបញ្ហាពេលរក្សាទុក Session!", icon: "error" });
  }
</script>
