<%- include('partials/header') %>

<style>
  :root {
    --primary: <%= theme || "#a855f7" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f8fafc;
    margin: 0;
    line-height: 1.6;
  }

  /* ១. Background បែបស្រទន់ បង្កើន UX កុំឱ្យចាំងភ្នែក */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.12;
    pointer-events: none;
  }

  /* ២. Magic Card Architecture - កែឱ្យសាមញ្ញជាងមុន តែមើលទៅថ្លៃថ្នូរ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* ៣. Input Styles */
  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 0.6rem;
    margin-left: 0.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .input-magic {
    background: rgba(15, 23, 42, 0.6) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: white !important;
    padding: 1.1rem 1.25rem !important;
    border-radius: 18px !important;
    width: 100%;
    outline: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input-magic:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.15);
    background: rgba(15, 23, 42, 0.8) !important;
  }

  /* ៤. Password Strength Meter - UI ថ្មី ស្រួលមើល */
  .strength-container {
    margin-top: 10px;
    padding: 0 5px;
  }

  .strength-bar-bg {
    height: 6px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
  }

  .strength-bar {
    height: 100%;
    width: 0%;
    transition: all 0.5s ease;
    border-radius: 10px;
  }

  /* ៥. Buttons */
  .btn-register {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: 700;
    padding: 1.1rem;
    border-radius: 18px;
    width: 100%;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 10px 15px -3px rgba(168, 85, 247, 0.3);
  }

  .btn-register:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(168, 85, 247, 0.4);
    filter: brightness(1.1);
  }

  .btn-google {
    background: #ffffff;
    color: #1e293b;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 1rem;
    border-radius: 18px;
    width: 100%;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }

  .btn-google:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  /* Layout */
  .auth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    min-height: 85vh;
  }

  @media (min-width: 1024px) {
    .auth-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 6s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
</style>

<canvas id="neural-bg"></canvas>

<main class="max-w-7xl mx-auto my-8 p-6 md:p-12 relative">
  <div class="auth-grid">
    <section
      class="space-y-8 animate-in fade-in slide-in-from-left-10 duration-700"
    >
      <div
        class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-purple-500/10 border border-purple-500/20"
      >
        <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
        <span class="text-purple-400 text-xs font-bold uppercase tracking-wider"
          >Create New Identity</span
        >
      </div>

      <h2 class="text-5xl md:text-7xl font-black leading-tight shimmer-text">
        ចាប់ផ្តើម <br />
        ជាមួយ AI
      </h2>

      <div class="space-y-6 max-w-xl">
        <p class="text-2xl font-light text-white italic">
          "បង្កើតគណនីតែមួយ ប្រើប្រាស់មន្តអាគម AI <br />បានគ្រប់ទីកន្លែង!"
        </p>
        <p class="text-slate-400 leading-relaxed text-lg">
          នៅពេលប្អូនមានគណនី វានឹងក្លាយជា **ខួរក្បាលទី២** របស់ប្អូន។
          រាល់ការសួរនាំ ការសរសេរកូដ និងការចងចាំសំខាន់ៗ
          នឹងត្រូវបានរក្សាទុកដោយសុវត្ថិភាពបំផុត។
        </p>
      </div>

      <div class="flex flex-wrap gap-8 pt-4">
        <div class="flex items-center gap-3">
          <span class="text-2xl">🌍</span>
          <span class="text-sm font-medium text-slate-300"
            >Sync គ្រប់ឧបករណ៍</span
          >
        </div>
        <div class="flex items-center gap-3">
          <span class="text-2xl">🛡️</span>
          <span class="text-sm font-medium text-slate-300"
            >សុវត្ថិភាពខ្ពស់បំផុត</span
          >
        </div>
      </div>
    </section>

    <section class="animate-in fade-in slide-in-from-right-10 duration-700">
      <div class="magic-card p-8 md:p-10">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-white uppercase tracking-tight">
            ចុះឈ្មោះបង្កើត Identity
          </h3>
          <p class="text-slate-500 text-xs mt-2 uppercase tracking-widest">
            Neural Enrollment Path
          </p>
        </div>

        <div class="space-y-5">
          <button
            onclick="signInWithGoogle()"
            id="googleBtn"
            class="btn-google"
          >
            <img
              src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
              class="w-5 h-5"
              alt="Google"
            />
            <span>ចុះឈ្មោះតាម Google</span>
          </button>

          <div class="flex items-center gap-3 py-2">
            <div class="h-px flex-1 bg-white/5"></div>
            <span
              class="text-[10px] text-slate-600 uppercase font-bold tracking-widest"
              >ឬ ប្រើអ៊ីមែល</span
            >
            <div class="h-px flex-1 bg-white/5"></div>
          </div>

          <div class="space-y-4">
            <div class="input-group">
              <label>អាសយដ្ឋានអ៊ីមែល</label>
              <input
                type="email"
                id="email"
                class="input-magic"
                placeholder="name@example.com"
              />
            </div>

            <div class="input-group">
              <label>លេខសម្ងាត់</label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  oninput="checkStrength(this.value)"
                  class="input-magic"
                  placeholder="យ៉ាងតិច ៨ ខ្ទង់"
                />
                <button
                  onclick="togglePass('password')"
                  class="absolute right-5 top-1/2 -translate-y-1/2 opacity-40 hover:opacity-100 transition-opacity"
                >
                  <span id="eye-1">👁️</span>
                </button>
              </div>

              <div class="strength-container">
                <div class="strength-bar-bg">
                  <div id="meter" class="strength-bar"></div>
                </div>
                <div class="flex justify-between mt-2">
                  <span
                    id="strengthText"
                    class="text-[10px] font-bold uppercase text-slate-600"
                    >កម្រិតសុវត្ថិភាព</span
                  >
                  <span
                    id="strengthPercent"
                    class="text-[10px] font-mono text-slate-500"
                    >0%</span
                  >
                </div>
              </div>
            </div>

            <div class="input-group">
              <label>បញ្ជាក់លេខសម្ងាត់</label>
              <div class="relative">
                <input
                  type="password"
                  id="confirmPassword"
                  class="input-magic"
                  placeholder="បញ្ចូលលេខសម្ងាត់ម្តងទៀត"
                />
                <button
                  onclick="togglePass('confirmPassword')"
                  class="absolute right-5 top-1/2 -translate-y-1/2 opacity-40 hover:opacity-100 transition-opacity"
                >
                  <span id="eye-2">👁️</span>
                </button>
              </div>
            </div>
          </div>

          <button
            onclick="handleRegister()"
            id="regBtn"
            class="btn-register mt-4"
          >
            បង្កើតគណនីឥឡូវនេះ
          </button>

          <p class="text-center text-sm text-slate-400 mt-6">
            មានគណនីរួចហើយ?
            <a
              href="/login"
              class="text-purple-400 font-bold hover:underline ml-1"
              >ចូលប្រើប្រាស់វិញ</a
            >
          </p>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import {
    getAuth,
    createUserWithEmailAndPassword,
    GoogleAuthProvider,
    signInWithPopup,
  } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "<%= firebaseConfig.apiKey %>",
    authDomain: "<%= firebaseConfig.authDomain %>",
    projectId: "<%= firebaseConfig.projectId %>",
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // ១. Background Animation (ធ្វើឱ្យទន់ និងរលូនជាងមុ人)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 50; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        size: Math.random() * 2,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#a855f7' %>";
    ctx.strokeStyle = "rgba(168, 85, 247, 0.05)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 180) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Password Logic
  window.togglePass = (id) => {
    const input = document.getElementById(id);
    input.type = input.type === "password" ? "text" : "password";
  };

  window.checkStrength = (pass) => {
    const meter = document.getElementById("meter");
    const text = document.getElementById("strengthText");
    const percent = document.getElementById("strengthPercent");
    let strength = 0;
    if (pass.length >= 8) strength += 25;
    if (pass.match(/[A-Z]/)) strength += 25;
    if (pass.match(/[0-9]/)) strength += 25;
    if (pass.match(/[^A-Za-z0-9]/)) strength += 25;

    meter.style.width = strength + "%";
    percent.innerText = strength + "%";

    if (strength <= 25) {
      meter.style.backgroundColor = "#ef4444";
      text.innerText = "ខ្សោយពេក";
      text.style.color = "#ef4444";
    } else if (strength <= 75) {
      meter.style.backgroundColor = "#f59e0b";
      text.innerText = "មធ្យម";
      text.style.color = "#f59e0b";
    } else {
      meter.style.backgroundColor = "#10b981";
      text.innerText = "រឹងមាំខ្លាំង";
      text.style.color = "#10b981";
    }
  };

  // ៣. Auth Handlers
  window.signInWithGoogle = async () => {
    const btn = document.getElementById("googleBtn");
    btn.innerHTML = "<span>កំពុងតភ្ជាប់...</span>";
    try {
      const result = await signInWithPopup(auth, provider);
      await sendTokenToBackend(result.user);
    } catch (error) {
      btn.innerHTML = `<span>ចុះឈ្មោះតាម Google</span>`;
      showError("ការតភ្ជាប់ជាមួយ Google បរាជ័យ!");
    }
  };

  window.handleRegister = async () => {
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;
    const confirmPassword = document.getElementById("confirmPassword").value;
    const btn = document.getElementById("regBtn");

    if (!email || !password) return showError("បំពេញឱ្យគ្រប់សិនបងប្រូ!");
    if (password !== confirmPassword)
      return showError("លេខសម្ងាត់ទាំងពីរមិនដូចគ្នាទេ!");
    if (password.length < 8)
      return showError("លេខសម្ងាត់ត្រូវមានយ៉ាងតិច ៨ ខ្ទង់!");

    btn.innerText = "កំពុងបង្កើតគណនី...";
    btn.classList.add("pointer-events-none", "opacity-70");

    try {
      const result = await createUserWithEmailAndPassword(
        auth,
        email,
        password,
      );
      await sendTokenToBackend(result.user);
    } catch (error) {
      btn.innerText = "បង្កើតគណនីឥឡូវនេះ";
      btn.classList.remove("pointer-events-none", "opacity-70");
      showError("អ៊ីមែលនេះមានគេប្រើបាត់ហើយ ឬមានបញ្ហាបច្ចេកទេស!");
    }
  };

  async function sendTokenToBackend(user) {
    const idToken = await user.getIdToken();
    const res = await fetch("/api/auth/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ idToken, isRegistering: true }),
    });
    if (res.ok) {
      window.location.href = "/dashboard";
    } else {
      const errData = await res.json();
      showError(errData.message);
    }
  }

  function showError(msg) {
    Swal.fire({
      icon: "error",
      title: "មានបញ្ហា!",
      text: msg,
      background: "#1e293b",
      color: "#fff",
      confirmButtonColor: "#a855f7",
    });
  }
</script>
