<%- include('partials/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --primary: <%= theme || "#6366f1" %>;
    --secondary: #f43f5e;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.08);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.6;
  }

  /* ១. Background បែបស្ងប់ស្ងាត់ ជួយឱ្យផ្ដោតអារម្មណ៍ */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.12;
    pointer-events: none;
  }

  /* ២. Card Design៖ បែបសាមញ្ញ ថ្លៃថ្នូរ មិនឆើតឆាយ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 1px solid var(--border-light);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  /* ៣. Dropzone៖ បង្រួមឱ្យស្អាត និងងាយយល់ */
  .drop-zone {
    border: 2px dashed rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    background: rgba(15, 23, 42, 0.3);
    transition: all 0.3s ease;
  }

  .drop-zone:hover {
    border-color: var(--primary);
    background: rgba(99, 102, 241, 0.05);
  }

  /* ៤. Input & Button */
  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 16px !important;
    color: white !important;
    padding: 1rem 1.5rem !important;
    width: 100%;
    outline: none;
    font-size: 1rem;
  }

  .input-custom:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
  }

  .btn-execute {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: 700;
    padding: 0.8rem 2rem;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.9rem;
  }

  .btn-execute:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -5px rgba(99, 102, 241, 0.4);
  }

  /* ៥. Promote Text Styles */
  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .prose-kida {
    line-height: 1.8;
    color: #cbd5e1;
  }
  .prose-kida strong {
    color: var(--primary);
  }
</style>

<canvas id="neural-bg"></canvas>

<main class="max-w-7xl mx-auto px-6 py-8 md:py-12 relative">
  <header class="text-center mb-16 animate-in fade-in duration-1000">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 mb-6"
    >
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span
        class="text-indigo-400 text-[10px] font-bold uppercase tracking-widest"
        >K-IDA Neural Extraction</span
      >
    </div>

    <h2
      class="text-5xl md:text-7xl font-black shimmer-text mb-6 uppercase italic"
    >
      K-IDA
    </h2>

    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xl md:text-3xl font-light text-slate-200 leading-snug">
        "ឈប់ហត់នឹងការអានឯកសាររាប់រយទំព័រ! ឱ្យ K-IDA ក្លាយជា
        <span class="text-indigo-400 font-bold">មន្តអាគម</span>
        នៃចំណេះដឹងប្អូន!"
      </p>
      <p class="text-slate-400 text-base md:text-lg italic leading-relaxed">
        តើបងធុញនឹងការអង្គុយអានឯកសារមែនទេ?
        <strong class="text-indigo-400">K-IDA</strong>
        នឹងប្រើប្រាស់ប្រព័ន្ធវៃឆ្លាត ដើម្បីអាន និងយល់គ្រប់ចំណុចក្នុង PDF បង។
        បោះឯកសារចូលមក រួចសួរចង់ដឹងអីក៏បាន
        វានឹងឆ្លើយយ៉ាងលម្អិតដូចមានអ្នកជំនាញនៅក្បែរខ្លួនអ៊ីចឹង! 😂
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <div
        class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/5"
      >
        <span class="text-lg">🔍</span>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-widest"
          >Instant Scan</span
        >
      </div>
      <div
        class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/5"
      >
        <span class="text-lg">🧠</span>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-widest"
          >Deep Context</span
        >
      </div>
      <div
        class="flex items-center gap-2 bg-white/5 px-4 py-2 rounded-xl border border-white/5"
      >
        <span class="text-lg">🇰🇭</span>
        <span class="text-xs font-bold text-slate-400 uppercase tracking-widest"
          >Khmer Native</span
        >
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <section class="xl:col-span-4 space-y-6">
      <div class="magic-card p-8">
        <h3
          class="text-[11px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6 flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> ០១.
          បញ្ចូលឯកសារ
        </h3>

        <div id="dropZone" class="drop-zone group">
          <div class="text-5xl mb-4 group-hover:scale-110 transition-transform">
            📄
          </div>
          <p class="text-white font-bold text-sm uppercase">
            បោះ PDF ចូល ឬ ចុចដើម្បីជ្រើសរើស
          </p>
          <input type="file" id="fileInput" class="hidden" accept=".pdf" />
        </div>

        <div
          id="textPreview"
          class="hidden mt-6 p-5 bg-white/5 rounded-2xl border border-white/5"
        >
          <div class="flex justify-between items-center mb-4">
            <span class="text-[10px] font-bold text-emerald-400 uppercase"
              >Neural Scan Success</span
            >
            <span
              id="pageCount"
              class="text-[10px] bg-emerald-500/10 px-2 py-1 rounded text-emerald-400 font-mono"
              >0 Pages</span
            >
          </div>
          <div
            id="previewContent"
            class="text-xs text-slate-500 h-32 overflow-y-auto italic no-scrollbar leading-relaxed"
          ></div>
        </div>
      </div>
    </section>

    <section class="xl:col-span-8 space-y-6">
      <div class="magic-card p-8">
        <h3
          class="text-[11px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-6 flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500"></span> ០២.
          សួរសំណួរទៅកាន់ AI
        </h3>
        <div class="flex flex-col md:flex-row gap-4">
          <input
            type="text"
            id="userQuery"
            class="input-custom"
            placeholder="សួរអំពីអ្វីដែលមានក្នុងឯកសារ... (ឧ. សង្ខេបចំណុចសំខាន់ឱ្យបងបន្តិច)"
          />
          <button
            onclick="askKIDA()"
            id="btnAsk"
            class="btn-execute whitespace-nowrap"
          >
            វិភាគទិន្នន័យ
          </button>
        </div>
      </div>

      <div id="responseContainer" class="hidden">
        <div class="magic-card p-10 md:p-12 border-l-[8px] border-indigo-500">
          <div
            id="pageBadge"
            class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 rounded-lg mb-6 opacity-0 transition-opacity"
          >
            <span class="text-[10px] font-bold text-indigo-400 uppercase"
              >រកឃើញនៅ:</span
            >
            <span id="pageSource" class="text-xs font-black text-white"
              >N/A</span
            >
          </div>
          <div id="aiAnswer" class="prose-kida italic"></div>
        </div>
      </div>

      <div
        id="loading"
        class="hidden magic-card p-20 flex flex-col items-center justify-center"
      >
        <div
          class="w-10 h-10 border-3 border-white/5 border-t-indigo-500 rounded-full animate-spin mb-4"
        ></div>
        <p
          class="text-indigo-400 text-[10px] font-bold uppercase tracking-[0.3em] animate-pulse"
        >
          កំពុងវិភាគទិន្នន័យពីអង្គចងចាំ...
        </p>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  const socket = io();
  const fileInput = document.getElementById("fileInput");
  let pdfPagesData = [];

  pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.4.120/pdf.worker.min.js";

  // ១. Background Animation (រង្វើល និងយឺត មិនឱ្យវិលមុខ)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 45; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#6366f1' %>";
    ctx.strokeStyle = "rgba(99, 102, 241, 0.04)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 160) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. File Handlers
  document.getElementById("dropZone").onclick = () => fileInput.click();
  fileInput.onchange = (e) => handleFile(e.target.files[0]);

  const dropZone = document.getElementById("dropZone");
  dropZone.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropZone.classList.add("bg-indigo-500/5");
  });
  dropZone.addEventListener("dragleave", () => {
    dropZone.classList.remove("bg-indigo-500/5");
  });
  dropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropZone.classList.remove("bg-indigo-500/5");
    handleFile(e.dataTransfer.files[0]);
  });

  async function handleFile(file) {
    if (!file || file.type !== "application/pdf") {
      return Swal.fire({
        text: "អូនសុំតែ PDF ទេបង! 😂",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }

    pdfPagesData = [];
    const reader = new FileReader();
    reader.onload = async function () {
      const typedarray = new Uint8Array(this.result);
      const pdf = await pdfjsLib.getDocument(typedarray).promise;
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        pdfPagesData.push({
          page: i,
          text: content.items.map((s) => s.str).join(" "),
        });
      }
      document.getElementById("previewContent").innerText =
        pdfPagesData[0].text.substring(0, 150) + "...";
      document.getElementById("pageCount").innerText =
        `${pdf.numPages} Pages Sync`;
      document.getElementById("textPreview").classList.remove("hidden");

      Swal.fire({
        text: "អូនអានចប់ហើយ! តោះ សួរមកបង!",
        icon: "success",
        toast: true,
        position: "top-end",
        showConfirmButton: false,
        timer: 3000,
      });
    };
    reader.readAsArrayBuffer(file);
  }

  function askKIDA() {
    const query = document.getElementById("userQuery").value.trim();
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!query || pdfPagesData.length === 0) {
      return Swal.fire({
        text: "បោះឯកសារឱ្យអូនអានសិន! 😂",
        icon: "warning",
        confirmButtonColor: "#6366f1",
      });
    }

    document.getElementById("loading").classList.remove("hidden");
    document.getElementById("responseContainer").classList.add("hidden");

    socket.emit("ask_kida", {
      userQuery: query,
      pages: pdfPagesData.slice(0, 50),
      firebaseUid: firebaseUid,
    });
  }

  socket.on("kida_result", (data) => {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("responseContainer").classList.remove("hidden");
    document.getElementById("aiAnswer").innerHTML = marked.parse(data.answer);

    const badge = document.getElementById("pageBadge");
    if (data.page_found) {
      document.getElementById("pageSource").innerText =
        "ទំព័រទី " + data.page_found;
      badge.style.opacity = "1";
    } else {
      badge.style.opacity = "0";
    }
    document
      .getElementById("responseContainer")
      .scrollIntoView({ behavior: "smooth" });
  });

    socket.on("error_occured", (msg) => {
    // ១. បិទ Loading និងបើកប៊ូតុងឱ្យដើរវិញជាមុនសិន ដើម្បីឱ្យ User អាចចុចម្តងទៀតបាន
    if (document.getElementById("loading")) {
      document.getElementById("loading").classList.add("hidden");
    }

    const btn =
      document.getElementById("btnAction") ||
      document.getElementById("btnSend");
    if (btn) btn.disabled = false;

    // ២. ប្ដូរពី alert(msg) មកប្រើ Premium Popup វិញ
    Swal.fire({
      title: "Neural Limit Reached! 🚀",
      text: msg,
      icon: "warning",
      background: "#0f172a", // ពណ៌ងងឹតស៊ីជាមួយ Theme បង
      color: "#f1f5f9",
      showCancelButton: true,
      confirmButtonColor: "#8b5cf6", // ពណ៌ស្វាយ Premium
      cancelButtonColor: "#475569",
      confirmButtonText: "ទៅ Upgrade ឥឡូវ 🔥",
      cancelButtonText: "ចាំពេលក្រោយ",
      backdrop: `rgba(15, 23, 42, 0.8) blur(8px)`, // បន្ថែម Blur ឱ្យមើលទៅថ្លៃថ្នូរ
      customClass: {
        popup: "rounded-[2.5rem] border border-white/10 shadow-2xl",
        title: "font-black uppercase tracking-widest text-indigo-400",
      },
    }).then((result) => {
      // ៣. បើ User ដាច់ចិត្តចុច Upgrade យើងបាញ់គេទៅទំព័រ Plans ហ្មង!
      if (result.isConfirmed) {
        window.location.href = "/plans";
      }
    });
  });
</script>
