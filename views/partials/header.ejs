<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Royal Cyber 2026</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;700&family=Plus+Jakarta+Sans:wght@300;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        :root {
            /* ប្រើពណ៌បែបស្ងប់ស្ងាត់ និងថ្លៃថ្នូរ */
            --primary: <%= theme || '#6366f1' %>; 
            --secondary: #06b6d4;
            --bg-dark: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.8);
            --border-light: rgba(255, 255, 255, 0.08);
        }
        
        body {
            font-family: "Kantumruy Pro", sans-serif;
            background: var(--bg-dark);
            color: #f1f5f9;
            margin: 0;
            overflow-x: hidden;
        }

        /* --- UI STYLES --- */
        .shimmer-royal {
            background: linear-gradient(90deg, #fff, var(--primary), #fff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 6s linear infinite;
        }
        @keyframes shine { to { background-position: 200% center; } }

        .active-link {
            color: var(--primary) !important;
            font-weight: 700;
            position: relative;
        }
        .active-link::after {
            content: '';
            position: absolute;
            bottom: -6px; left: 0; width: 100%; height: 2px;
            background: var(--primary);
            border-radius: 99px;
        }

        .nav-glass {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-light);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        }

        .user-avatar {
            border: 2px solid var(--border-light);
            transition: all 0.3s ease;
        }
        .user-avatar:hover { 
            border-color: var(--primary);
            transform: scale(1.05); 
        }

        /* --- DROPDOWN DESIGN --- */
        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            padding-top: 12px;
            min-width: 220px;
            z-index: 100;
        }
        .dropdown-inner {
            background: #1e293b;
            border: 1px solid var(--border-light);
            border-radius: 20px;
            padding: 10px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }
        /* Desktop Hover */
        @media (hover: hover) {
            .profile-group:hover .dropdown-content { display: block; animation: slideUp 0.3s ease-out; }
        }
        /* Mobile Active */
        .profile-group.active .dropdown-content { display: block; animation: slideUp 0.3s ease-out; }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body>
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(99,102,241,0.05)_0%,transparent_50%)] -z-20"></div>

    <nav class="sticky top-0 z-50 nav-glass px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-4">
                <a href="/" class="group">
                    <h1 class="text-xl md:text-2xl font-black tracking-tight shimmer-royal uppercase italic">
                        Royal Suite <span class="text-[9px] bg-indigo-500/20 text-indigo-400 px-2 py-0.5 rounded border border-indigo-500/30 ml-1">V2.6</span>
                    </h1>
                </a>
            </div>

            <div class="hidden lg:flex items-center gap-8 text-[11px] font-bold uppercase tracking-wider">
                <% 
                const tools = [
                    { name: 'Reviewer', path: '/', key: 'reviewer', desc: 'ពិនិត្យ និងកែលម្អកូដ' },
                    { name: 'Culture', path: '/culture', key: 'culture', desc: 'មគ្គុទ្ទេសក៍វប្បធម៌ខ្មែរ' },
                    { name: 'Visualizer', path: '/visualizer', key: 'visualizer', desc: 'បំប្លែង Logic ទៅជាផែនទី' },
                    { name: 'Study', path: '/study-buddy', key: 'study', desc: 'មិត្តរួមសិក្សា AI' },
                    { name: 'K-IDA', path: '/kida', key: 'kida', desc: 'អ្នកជំនាញអាន PDF' },
                    { name: 'Tutor', path: '/tutor', key: 'tutor', desc: 'គ្រូជំនួយ AI' }
                ];
                %>

                <% tools.forEach(tool => { %>
                    <div class="relative group/link">
                        <% if (locals.user) { %>
                            <a href="<%= tool.path %>" class="<%= pageKey === tool.key ? 'active-link' : 'text-slate-400 hover:text-white' %> transition-colors">
                                <%= tool.name %>
                            </a>
                        <% } else { %>
                            <a href="javascript:void(0)" onclick="checkAuthBeforeAI()" class="text-slate-400 hover:text-white transition-colors">
                                <%= tool.name %>
                            </a>
                        <% } %>
                        <span class="absolute -bottom-12 left-1/2 -translate-x-1/2 w-32 text-center text-[9px] text-slate-300 opacity-0 group-hover/link:opacity-100 transition-all pointer-events-none bg-slate-800 p-2 rounded-lg border border-white/5 shadow-xl">
                            <%= tool.desc %>
                        </span>
                    </div>
                <% }); %>
                
                <a href="/history" class="<%= pageKey === 'history' ? 'active-link' : 'text-slate-400 hover:text-white' %> transition border-l border-white/5 pl-8">Archive</a>
            </div>

            <div class="flex items-center gap-4">
                <% if (locals.user) { %>
                    <div class="relative profile-group">
                        <div class="flex items-center gap-3 cursor-pointer">
                            <div class="hidden md:flex flex-col items-end">
                                <span class="text-[10px] font-bold text-white uppercase"><%= user.displayName %></span>
                                <span class="text-[8px] text-indigo-400 font-medium uppercase tracking-tighter">Identity Linked</span>
                            </div>
                            <img src="<%= user.photoURL && user.photoURL !== '' ? user.photoURL : 'https://api.dicebear.com/7.x/bottts/svg?seed=' + user.displayName %>" 
                                 class="w-10 h-10 rounded-xl user-avatar object-cover bg-slate-800" alt="Profile">
                        </div>

                        <div class="dropdown-content">
                            <div class="dropdown-inner">
                                <a href="/dashboard" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 text-[10px] font-bold uppercase text-slate-300 hover:text-white transition-all">
                                    <span>📊</span> Dashboard
                                </a>
                                <a href="/user/profile" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 text-[10px] font-bold uppercase text-slate-300 hover:text-white transition-all">
                                    <span>⚙️</span> Settings
                                </a>
                                <div class="h-px bg-white/5 my-2 mx-2"></div>
                                <a href="/logout" class="flex items-center gap-3 p-3 rounded-xl hover:bg-red-500/10 text-[10px] font-bold uppercase text-red-400 transition-all">
                                    <span>💀</span> Sign Out
                                </a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-[10px] font-bold uppercase tracking-widest transition-all shadow-lg shadow-indigo-500/20">
                        Sign In
                    </a>
                <% } %>
            </div>
        </div>

        <div class="flex lg:hidden gap-6 mt-5 overflow-x-auto pb-2 text-[10px] font-bold uppercase tracking-wide no-scrollbar border-t border-white/5 pt-4">
            <% tools.forEach(tool => { %>
                <a href="<%= locals.user ? tool.path : 'javascript:void(0)' %>" 
                   onclick="<%= locals.user ? '' : 'checkAuthBeforeAI()' %>"
                   class="<%= pageKey === tool.key ? 'active-link' : 'text-slate-500' %> whitespace-nowrap">
                    <%= tool.name %>
                </a>
            <% }); %>
            <a href="/history" class="<%= pageKey === 'history' ? 'active-link' : 'text-slate-500' %> whitespace-nowrap">Archive</a>
        </div>
    </nav>

    <script>
    /**
     * Mobile Dropdown Toggle
     */
    document.addEventListener('DOMContentLoaded', () => {
        const profileGroup = document.querySelector('.profile-group');
        if (profileGroup) {
            profileGroup.addEventListener('click', function(e) {
                if (window.innerWidth < 1024) {
                    e.stopPropagation();
                    this.classList.toggle('active');
                }
            });
        }
        document.addEventListener('click', () => {
            if (profileGroup) profileGroup.classList.remove('active');
        });
    });

    /**
     * Auth Guard Popup
     */
    function checkAuthBeforeAI() {
        Swal.fire({
            title: 'អត់ទាន់ Login ហី? 😹',
            text: "ចូលគណនីសិនមកមេ ដើម្បីប្រើ AI ឱ្យអស់សមត្ថភាព! ចាំបងជួយ! 🔥",
            imageUrl: '/images/1.png', 
            imageWidth: 120,
            imageHeight: 120,
            background: '#1e293b',
            color: '#f1f5f9',
            showCancelButton: true,
            confirmButtonText: 'ទៅ Login ឥឡូវ',
            cancelButtonText: 'ចាំបន្តិច',
            confirmButtonColor: '#6366f1',
            cancelButtonColor: '#475569',
            showClass: { popup: 'animate__animated animate__fadeInDown' },
            hideClass: { popup: 'animate__animated animate__fadeOutUp' },
            customClass: {
                popup: 'rounded-[2rem] border border-white/10 shadow-2xl',
                title: 'font-bold text-indigo-400'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/login';
            }
        });
    }
    </script>