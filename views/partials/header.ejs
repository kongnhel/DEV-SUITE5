<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/images/logo.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;700&family=Plus+Jakarta+Sans:wght@300;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <style>
        :root {
            --primary: <%= theme || '#6366f1' %>; 
            --secondary: #06b6d4;
            --bg-dark: #070b14;
            --card-bg: rgba(30, 41, 59, 0.8);
            --border-light: rgba(255, 255, 255, 0.08);
        }
        
        body { font-family: "Kantumruy Pro", sans-serif; background: var(--bg-dark); color: #f1f5f9; margin: 0; }

        .shimmer-royal {
            background: linear-gradient(90deg, #fff, var(--primary), #fff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shine 6s linear infinite;
        }
        @keyframes shine { to { background-position: 200% center; } }

        .nav-glass {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-light);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        /* --- 🛠️ វិធីកែ Dropdown ឱ្យស្រួលចុច (THE FIX) --- */
        .dropdown-wrapper { position: relative; }
        
        .dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 280px;
            z-index: 100;
            /* បង្កើត "ស្ពានអាកាស" ដើម្បីកុំឱ្យ Mouse ធ្លាក់ក្នុងរណ្ដៅ */
            padding-top: 15px; 
        }
        
        .dropdown-inner {
            background: #111827; /* ពណ៌រាងដិតបន្តិចឱ្យងាយមើល */
            border: 1px solid var(--border-light);
            border-radius: 24px;
            padding: 12px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
        }

        /* ពេល Hover លើ Wrapper ឱ្យបង្ហាញ Menu ភ្លាម */
        .dropdown-wrapper:hover .dropdown-menu { 
            display: block; 
            animation: slideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); 
        }

        @keyframes slideIn { 
            from { opacity: 0; transform: translateY(15px) scale(0.95); } 
            to { opacity: 1; transform: translateY(0) scale(1); } 
        }

        .nav-item-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 16px;
            transition: all 0.2s;
            color: #94a3b8;
        }
        .nav-item-link:hover { background: rgba(255,255,255,0.05); color: white; transform: translateX(5px); }
        .nav-item-link.active { color: var(--primary); background: rgba(99,102,241,0.08); }

        .active-dot { width: 5px; height: 5px; background: var(--primary); border-radius: 50%; box-shadow: 0 0 10px var(--primary); }
        .user-avatar { border: 2px solid var(--border-light); transition: 0.3s; }
        .user-avatar:hover { border-color: var(--primary); transform: scale(1.05); }

        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body>
    <div class="fixed inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(99,102,241,0.05)_0%,transparent_50%)] -z-20"></div>

    <% 
    const categories = [
        {
            title: 'Development',
            icon: '💻',
            items: [
                { name: 'Code Reviewer', path: '/', key: 'reviewer', desc: 'ពិនិត្យ និងកែលម្អកូដប្អូន' },
                { name: 'Architect AI', path: '/architect', key: 'architect', desc: 'រៀបចំផែនការ និងយុទ្ធសាស្ត្រ' },
                { name: 'Visualizer', path: '/visualizer', key: 'visualizer', desc: 'បំប្លែង Logic ទៅជា Flow' }
            ]
        },
        {
            title: 'Academy',
            icon: '📚',
            items: [
                { name: 'Study Buddy', path: '/study-buddy', key: 'study', desc: 'មិត្តរួមសិក្សា AI កម្រិតខ្ពស់' },
                { name: 'K-IDA Docs', path: '/kida', key: 'kida', desc: 'អ្នកជំនាញអាន PDF និង Word' },
                { name: 'AI Tutor', path: '/tutor', key: 'tutor', desc: 'គ្រូជំនួយផ្ទាល់ខ្លួនបង' }
            ]
        },
        {
            title: 'Life & Culture',
            icon: '🏯',
            items: [
                { name: 'Khmer Culture', path: '/culture', key: 'culture', desc: 'មគ្គុទ្ទេសក៍វប្បធម៌ខ្មែរ' },
                { name: 'Love Guru', path: '/love-guru', key: 'love', desc: 'គ្រូពេទ្យស្នេហ៍ និងការតស៊ូ' }
            ]
        }
    ];
    %>

    <nav class="sticky top-0 z-50 nav-glass px-6 py-4">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <div class="flex items-center gap-10">
                <a href="/" class="group">
                    <h1 class="text-xl md:text-2xl font-black tracking-tight shimmer-royal uppercase italic">
                        <img src="/images/logo.png" alt="Dev Suite Logo" class="inline-block w-12 h-12 mr-2 -mt-1">
                        Dev Suite <span class="text-[9px] bg-indigo-500/20 text-indigo-400 px-2 py-0.5 rounded border border-indigo-500/30 ml-1">V1.0</span>
                    </h1>
                </a>

                <div class="hidden lg:flex items-center gap-8">
                    <% categories.forEach(cat => { %>
                        <div class="dropdown-wrapper">
                            <button class="flex items-center gap-2 text-[11px] font-black uppercase tracking-wider text-slate-400 hover:text-white transition-colors py-2">
                                <span><%= cat.icon %></span>
                                <%= cat.title %>
                                <svg class="w-3 h-3 opacity-40 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
                            </button>
                            
                            <div class="dropdown-menu">
                                <div class="dropdown-inner">
                                    <div class="text-[9px] font-black text-slate-500 uppercase tracking-[0.2em] mb-4 px-4 border-b border-white/5 pb-2">
                                        <%= cat.title %> Resources
                                    </div>
                                    <% cat.items.forEach(item => { %>
                                        <a href="<%= locals.user ? item.path : 'javascript:void(0)' %>" 
                                           onclick="<%= locals.user ? '' : 'checkAuthBeforeAI()' %>"
                                           class="nav-item-link <%= pageKey === item.key ? 'active' : '' %>">
                                            <div class="flex-1">
                                                <div class="text-[11px] font-black uppercase tracking-tight flex justify-between items-center mb-0.5">
                                                    <%= item.name %>
                                                    <% if(pageKey === item.key) { %><span class="active-dot"></span><% } %>
                                                </div>
                                                <div class="text-[9px] text-slate-500 font-medium"><%= item.desc %></div>
                                            </div>
                                        </a>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                    
                    <a href="/history" class="<%= pageKey === 'history' ? 'text-indigo-400' : 'text-slate-400 hover:text-white' %> text-[11px] font-black uppercase tracking-wider border-l border-white/5 pl-8 transition-all">history</a>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <% if (locals.user) { %>
                    <div class="relative profile-group group">
                        <div class="flex items-center gap-3 cursor-pointer">
                            <div class="hidden md:flex flex-col items-end">
                                <span class="text-[10px] font-black text-white uppercase tracking-tighter"><%= user.displayName %></span>
                                <span class="text-[8px] text-indigo-400 font-bold uppercase tracking-widest">Premium Core</span>
                            </div>
                            <img src="<%= user.photoURL || 'https://api.dicebear.com/7.x/bottts/svg?seed=' + user.displayName %>" 
                                 class="w-10 h-10 rounded-xl user-avatar object-cover bg-slate-800 shadow-lg shadow-indigo-500/10" alt="Profile">
                        </div>

                        <div class="absolute right-0 top-full pt-4 hidden group-hover:block animate__animated animate__fadeIn animate__faster">
                            <div class="w-56 bg-[#111827] border border-white/10 rounded-2xl p-2 shadow-2xl">
                                <a href="/dashboard" class="flex items-center gap-3 p-3.5 rounded-xl hover:bg-white/5 text-[10px] font-black uppercase text-slate-300 hover:text-white transition-all">📊 Dashboard</a>
                                <a href="/user/profile" class="flex items-center gap-3 p-3.5 rounded-xl hover:bg-white/5 text-[10px] font-black uppercase text-slate-300 hover:text-white transition-all">⚙️ Settings</a>
                                <a href="/plan" class="flex items-center gap-3 p-3.5 rounded-xl hover:bg-white/5 text-[10px] font-black uppercase text-slate-300 hover:text-white transition-all">📋 Plan Generator</a>
                                <div class="h-px bg-white/5 my-2 mx-2"></div>
                                <a href="/logout" class="flex items-center gap-3 p-3.5 rounded-xl hover:bg-red-500/10 text-[10px] font-black uppercase text-red-400 transition-all">💀 Sign Out</a>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-[10px] font-black uppercase tracking-widest transition-all shadow-lg shadow-indigo-500/20">Sign In</a>
                <% } %>
            </div>
        </div>

        <div class="flex lg:hidden gap-6 mt-5 overflow-x-auto pb-4 text-[10px] font-black uppercase tracking-widest no-scrollbar border-t border-white/5 pt-5">
            <% categories.forEach(cat => { %>
                <% cat.items.forEach(item => { %>
                    <a href="<%= locals.user ? item.path : 'javascript:void(0)' %>" 
                       onclick="<%= locals.user ? '' : 'checkAuthBeforeAI()' %>"
                       class="<%= pageKey === item.key ? 'text-indigo-400' : 'text-slate-500' %> whitespace-nowrap"><%= item.name %></a>
                <% }); %>
            <% }); %>
            <a href="/history" class="<%= pageKey === 'history' ? 'text-indigo-400' : 'text-slate-500' %> whitespace-nowrap">Archive</a>
        </div>
    </nav>

    <script>
    function checkAuthBeforeAI() {
        Swal.fire({
            title: 'អត់ទាន់ Login ហី? 😹',
            text: "ចូលគណនីសិនមកមេ ដើម្បីប្រើ AI ឱ្យអស់សមត្ថភាព! ចាំអូនជួយ! 😙🔥",
            imageUrl: '/images/1.png', imageWidth: 100, imageHeight: 100,
            background: '#0f172a', color: '#f1f5f9',
            showCancelButton: true, confirmButtonText: 'ទៅ Login ឥឡូវ', cancelButtonText: 'ចាំបន្តិច',
            confirmButtonColor: '#6366f1', cancelButtonColor: '#475569',
            customClass: { popup: 'rounded-[2.5rem] border border-white/10 shadow-2xl' }
        }).then((result) => { if (result.isConfirmed) window.location.href = '/login'; });
    }
    </script>