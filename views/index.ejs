<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --primary: <%= theme || "#22d3ee" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.1);
    /* Mood Variables */
    --mood-color: var(--primary);
    --mood-glow: rgba(34, 211, 238, 0.1);
  }

  body {
    background-color: var(--bg-dark);
    color: #e2e8f0;
    font-family: "Kantumruy Pro", sans-serif;
    margin: 0;
    line-height: 1.6;
    transition: background-color 1s ease; /* បន្ថែម Transition សម្រាប់ដូរពណ៌ផ្ទៃក្រោយ */
  }

  /* ១. Background បែបស្ងប់ស្ងាត់ មិនឱ្យរំខានភ្នែក */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.1;
    pointer-events: none;
  }

  .hero-glow {
    background: radial-gradient(
      circle at 50% 50%,
      var(--mood-glow) 0%,
      transparent 70%
    );
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    transition: all 1s ease;
  }

  /* Mood States - បន្ថែមថ្មី */
  .mood-angry {
    --mood-color: #f43f5e;
    --mood-glow: rgba(244, 63, 94, 0.2);
  }
  .mood-impressed {
    --mood-color: #fbbf24;
    --mood-glow: rgba(251, 191, 36, 0.2);
  }
  .mood-confused {
    --mood-color: #a855f7;
    --mood-glow: rgba(168, 85, 247, 0.2);
  }

  /* ២. Card Design៖ បែបសាមញ្ញ ថ្លៃថ្នូរ មិនឆើតឆាយ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 24px;
    border: 1px solid var(--border-light);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  .magic-card:hover {
    border-color: var(--mood-color); /* កែពី primary មក mood-color */
  }

  /* ៣. Inputs & Code Editor */
  .input-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 8px;
    margin-left: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 16px !important;
    color: white !important;
    padding: 1rem 1.25rem !important;
    width: 100%;
    outline: none;
    transition: all 0.3s ease;
  }

  .code-area {
    font-family: "Fira Code", "Courier New", monospace;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--primary) !important;
    resize: none;
  }

  .input-custom:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.1) !important;
  }

  /* ៤. Button Style */
  .btn-evolution {
    background: linear-gradient(
      135deg,
      var(--mood-color),
      var(--secondary)
    ); /* កែពី primary មក mood-color */
    color: #0f172a;
    font-weight: 800;
    padding: 1.1rem;
    border-radius: 18px;
    width: 100%;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 10px 15px -3px rgba(34, 211, 238, 0.3);
  }

  .btn-evolution:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(34, 211, 238, 0.4);
    filter: brightness(1.1);
  }

  /* ៥. Output & Result Area */
  .shimmer-text {
    background: linear-gradient(
      90deg,
      #fff,
      var(--mood-color),
      #fff
    ); /* កែពី primary មក mood-color */
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .prose-reviewer {
    line-height: 1.8;
    color: #cbd5e1;
    font-size: 1.05rem;
  }
  .prose-reviewer strong {
    color: var(--primary);
  }

  .code-output-container {
    background: #010409;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  /* បន្ថែមក្នុង <style> */
  .ai-speaking {
    border: 2px solid var(--mood-color) !important;
    box-shadow: 0 0 20px var(--mood-glow);
    animation: pulse-border 2s infinite;
  }

  @keyframes pulse-border {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.01);
    }
    100% {
      transform: scale(1);
    }
  }
</style>

<canvas id="neural-bg"></canvas>
<div id="hero-glow-layer" class="hero-glow fixed inset-0 -z-10"></div>

<main class="max-w-7xl mx-auto px-6 py-12 relative">
  <header class="text-center mb-16 animate-in fade-in duration-700">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 mb-6"
    >
      <span
        id="mood-dot"
        class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"
      ></span>
      <span
        class="text-cyan-400 text-[10px] font-bold uppercase tracking-widest"
        >Evolution System V2.6</span
      >
    </div>

    <h2
      class="text-5xl md:text-8xl font-black shimmer-text mb-8 uppercase italic leading-none"
    >
      EVOLUTION
    </h2>

    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xl md:text-3xl font-light text-slate-200 leading-snug">
        "កុំឱ្យកូដបែកថ្នាំ បំផ្លាញក្តីស្រមៃប្អូន! ឱ្យបង AI ជួយ
        <span class="text-cyan-400 font-bold">កែលម្អកូដ</span>
        ឱ្យកាន់តែអស្ចារ្យ!"
      </p>
      <p class="text-slate-400 text-base md:text-lg italic leading-relaxed">
        បងធុញនឹង Error មែនទេ?
        <strong class="text-cyan-400">Evolution</strong> នឹងប្រើប្រាស់ Neural
        Engine ដើម្បីវិភាគកូដបងយ៉ាងស៊ីជម្រៅ។
      </p>
    </div>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
    <section class="xl:col-span-6 space-y-6">
      <div class="magic-card p-8 md:p-10 shadow-xl">
        <div class="space-y-8">
          <div class="input-group">
            <label>អារម្មណ៍ចំពោះកូដនេះ (Optional)</label>
            <textarea
              id="userComment"
              class="input-custom h-24 resize-none"
              placeholder="តើបងមានអារម្មណ៍យ៉ាងណាជាមួយកូដនេះ?"
            ></textarea>
          </div>

          <div class="input-group">
            <label>បញ្ចូលកូដដែលចង់ឱ្យអូន Review</label>
            <textarea
              id="code"
              class="input-custom code-area h-96 md:h-[500px] no-scrollbar shadow-inner"
              placeholder="// បិទភ្ជាប់កូដដែលញ៉េរញ៉ៃរបស់បងនៅទីនេះ..."
            ></textarea>
          </div>

          <button onclick="sendCode()" id="btnSend" class="btn-evolution">
            ចាប់ផ្ដើមពិនិត្យកូដ
          </button>
        </div>
      </div>
    </section>

    <section class="xl:col-span-6">
      <div
        id="loading"
        class="hidden magic-card p-32 flex flex-col items-center justify-center"
      >
        <div
          class="w-12 h-12 border-4 border-white/5 border-t-cyan-500 rounded-full animate-spin mb-6"
        ></div>
        <p
          class="text-cyan-500 text-xs font-bold uppercase tracking-[0.3em] animate-pulse"
        >
          កំពុងវិភាគ Logic នៃកូដ...
        </p>
      </div>

      <div
        id="aiSection"
        class="hidden space-y-6 animate-in slide-in-from-bottom-6 duration-700"
      >
        <div
          id="aiMoodCard"
          class="magic-card p-8 md:p-10 border-l-[10px] border-cyan-500 bg-cyan-500/5"
        >
          <div
            id="aiMood"
            class="text-[10px] font-bold text-cyan-400/60 uppercase tracking-widest mb-4"
          ></div>
          <div
            id="aiJoke"
            class="text-lg md:text-2xl font-light text-white italic leading-relaxed"
          ></div>
          <button
            onclick="speakResponse()"
            class="mt-4 flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-cyan-400 hover:text-white transition-all"
          >
            <span>🔊 ស្តាប់សំឡេង AI</span>
          </button>
        </div>

        <div class="magic-card p-8 md:p-10">
          <h4
            class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-6 flex items-center gap-3"
          >
            <span class="w-8 h-px bg-slate-700"></span> លទ្ធផលនៃការវិភាគ
          </h4>
          <div id="aiReview" class="prose-reviewer"></div>
        </div>

        <div class="code-output-container">
          <div
            class="px-6 py-4 bg-white/5 border-b border-white/5 flex justify-between items-center"
          >
            <span
              class="text-[10px] font-bold text-slate-500 uppercase italic tracking-wider"
              >Evolution_Fixed_Source.js</span
            >
            <button
              onclick="copyCode()"
              class="text-[10px] font-bold text-cyan-400 hover:text-white transition-all uppercase tracking-widest border border-cyan-500/20 px-4 py-1.5 rounded-lg"
            >
              ចម្លងកូដ
            </button>
          </div>
          <pre
            class="p-6 md:p-8 overflow-x-auto"
          ><code id="fixedCode" class="language-javascript text-sm md:text-base"></code></pre>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

<link
  href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css"
  rel="stylesheet"
/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>

<script>
  const socket = io();
  const btnSend = document.getElementById("btnSend");
  const loading = document.getElementById("loading");
  const aiSection = document.getElementById("aiSection");
  let lastAIJoke = ""; // រក្សាទុកសម្រាប់អានសំឡេង

  // ១. Background Animation
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    const count = window.innerWidth < 768 ? 30 : 60;
    for (let i = 0; i < count; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#00f2ff' %>";
    ctx.strokeStyle = "rgba(34, 211, 238, 0.03)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 150) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // មុខងារ Mood Indicator - បន្ថែមថ្មី
  function applyMood(sentiment) {
    const s = sentiment.toLowerCase();
    const body = document.body;
    const moodCard = document.getElementById("aiMoodCard");

    // Reset classes
    body.classList.remove("mood-angry", "mood-impressed", "mood-confused");
    moodCard.classList.remove("ai-speaking");

    if (s.includes("angry") || s.includes("roasted"))
      body.classList.add("mood-angry");
    else if (s.includes("impressed") || s.includes("good"))
      body.classList.add("mood-impressed");
    else if (s.includes("confused")) body.classList.add("mood-confused");

    setTimeout(() => moodCard.classList.add("ai-speaking"), 100);
  }

  // មុខងារ Voice - បន្ថែមថ្មី
  // function speakResponse() {
  //   if ("speechSynthesis" in window && lastAIJoke) {
  //     const msg = new SpeechSynthesisUtterance(lastAIJoke);
  //     msg.lang = "km-KH"; // ភាសាខ្មែរ
  //     window.speechSynthesis.speak(msg);
  //   }
  // }

  let audioData = null;
  // មុខងារនិយាយខ្មែរដោយប្រើ Google Translate TTS (Free & Work 100%)
  function speakResponse() {
    if (!lastAIJoke) return;

    // ១. បង្កើត URL សម្រាប់ហៅសំឡេងខ្មែរពី Google
    // យើងប្រើ encodeURIComponent ដើម្បីការពារបញ្ហាអក្សរខ្មែរក្នុង URL
    const text = encodeURIComponent(lastAIJoke);
    const ttsUrl = `https://translate.google.com/translate_tts?ie=UTF-8&q=${text}&tl=km&client=tw-ob`;

    // ២. បង្កើត Audio Object រួចឱ្យវា Play
    const audio = new Audio(ttsUrl);

    // បន្ថែម Visual Effect ពេលកំពុងនិយាយ (ប្តូរពណ៌ Card ឱ្យរំញ័រ)
    const moodCard = document.getElementById("aiMoodCard");
    moodCard.classList.add("ai-speaking");

    audio
      .play()
      .then(() => {
        console.log("AI កំពុងនិយាយភាសាខ្មែរ...");
      })
      .catch((e) => {
        console.error("ការ Play សំឡេងមានបញ្ហា៖ ", e);
        // បើ Google ប្លុក (ករណីចុចញាប់ពេក) យើងប្រើ Backup ធម្មតា
        const msg = new SpeechSynthesisUtterance(lastAIJoke);
        msg.lang = "km-KH";
        window.speechSynthesis.speak(msg);
      });

    // ឈប់រំញ័រពេលនិយាយចប់ (ប្រហែល ៣-៥ វិនាទីតាមប្រវែងអក្សរ)
    audio.onended = () => {
      moodCard.classList.remove("ai-speaking");
    };
  }
  // ២. AI Review Interaction
  function sendCode() {
    const code = document.getElementById("code").value.trim();
    const userComment = document.getElementById("userComment").value;
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!code)
      return Swal.fire({
        text: "បោះកូដចូលមកអាបង! 😂",
        icon: "info",
        confirmButtonColor: "#22d3ee",
      });
    if (!firebaseUid)
      return Swal.fire({
        text: "សូមចូលគណនីសិនបង!",
        icon: "warning",
        confirmButtonColor: "#22d3ee",
      });

    loading.classList.remove("hidden");
    aiSection.classList.add("hidden");
    btnSend.disabled = true;

    socket.emit("review_code", { code, userComment, firebaseUid });
  }

  socket.on("review_result", (res) => {
    loading.classList.add("hidden");
    aiSection.classList.remove("hidden");
    btnSend.disabled = false;

    lastAIJoke = res.humorous_response; // រក្សាទុកសម្រាប់និយាយ
    applyMood(res.sentiment); // អនុវត្តពណ៌តាមអារម្មណ៍

    document.getElementById("aiMood").innerText =
      "Neural_Mood: " + res.sentiment;
    document.getElementById("aiMoodCard").style.borderColor =
      "var(--mood-color)";

    typeWriter("aiJoke", "“" + res.humorous_response + "”");
    document.getElementById("aiReview").innerHTML = marked.parse(
      res.technical_review,
    );

    const codeContainer = document.getElementById("fixedCode");
    codeContainer.textContent =
      res.fixed_code || "// លទ្ធផលកូដនឹងបង្ហាញនៅទីនេះ។";
    Prism.highlightElement(codeContainer);
    aiSection.scrollIntoView({ behavior: "smooth" });

    if (res.audioBase64) {
      audioData = res.audioBase64;
      // ចង់ឱ្យវាអានភ្លាមៗពេល Result ចេញក៏បាន
      speakResponse();
    }
  });

  function typeWriter(id, text) {
    let i = 0;
    const el = document.getElementById(id);
    el.innerHTML = "";
    function type() {
      if (i < text.length) {
        el.innerHTML += text.charAt(i);
        i++;
        setTimeout(type, 15);
      }
    }
    type();
  }

  function copyCode() {
    const code = document.getElementById("fixedCode").textContent;
    navigator.clipboard.writeText(code);
    Swal.fire({
      text: "ចម្លងកូដបានជោគជ័យ!(ចេះតែ Ctrl+C និង Ctrl + V ហា) 😂",
      icon: "success",
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2000,
    });
  }
</script>
