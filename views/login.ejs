<%- include('partials/header') %>

<style>
  :root {
    --primary: <%= theme || "#22d3ee" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f8fafc;
    margin: 0;
    line-height: 1.6;
  }

  /* ១. Background បែបស្រទន់ មិនឱ្យរំខានភ្នែក */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.15;
    pointer-events: none;
  }

  /* ២. Card Design ថ្មី៖ ស្អាត បែបទំនើប តែមិនញ៉ាំញ៉ាំ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease;
  }

  .input-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    margin-left: 0.25rem;
  }

  .input-magic {
    background: rgba(15, 23, 42, 0.6) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    color: white !important;
    padding: 1rem 1.25rem !important;
    border-radius: 16px !important;
    width: 100%;
    outline: none;
    transition: all 0.3s ease;
  }

  .input-magic:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.15);
  }

  /* ៣. Button៖ ធំ ងាយស្រួលចុច (Good for all ages) */
  .btn-primary-custom {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #0f172a;
    font-weight: 700;
    padding: 1rem;
    border-radius: 16px;
    width: 100%;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-size: 1rem;
  }

  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px rgba(34, 211, 238, 0.4);
    opacity: 0.9;
  }

  .btn-google {
    background: white;
    color: #374151;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0.875rem;
    border-radius: 16px;
    width: 100%;
    border: 1px solid #e5e7eb;
    transition: all 0.3s ease;
  }

  .btn-google:hover {
    background: #f9fafb;
    border-color: #d1d5db;
  }

  /* ៤. Layout Adjustment */
  .auth-container {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .auth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 1100px;
    width: 100%;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .auth-grid {
      grid-template-columns: 1fr 450px;
    }
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
</style>

<canvas id="neural-bg"></canvas>

<div class="auth-container">
  <main class="auth-grid">
    <section class="space-y-8 animate-in fade-in duration-700">
      <div>
        <h2
          class="text-4xl md:text-6xl font-extrabold leading-tight shimmer-text"
        >
          ស្វាគមន៍មកកាន់ <br />
          ពិភព AI ឆ្លាតវៃ
        </h2>
        <p class="mt-6 text-lg md:text-xl text-slate-300 max-w-lg">
          ចូលប្រើប្រាស់គណនីរបស់អ្នក ដើម្បីបន្តដំណើរការជាមួយ
          <span class="text-cyan-400 font-semibold">AI ផ្ទាល់ខ្លួន</span>
          ដែលយល់ចិត្តអ្នកបំផុត!
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div
          class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10"
        >
          <span class="text-2xl">🔐</span>
          <div>
            <h4 class="text-sm font-bold text-white">សុវត្ថិភាពខ្ពស់</h4>
            <p class="text-xs text-slate-400">ការពារទិន្នន័យរបស់អ្នក</p>
          </div>
        </div>
        <div
          class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10"
        >
          <span class="text-2xl">🧠</span>
          <div>
            <h4 class="text-sm font-bold text-white">ការចងចាំឆ្លាតវៃ</h4>
            <p class="text-xs text-slate-400">AI នឹងចងចាំអ្វីដែលអ្នកចង់បាន</p>
          </div>
        </div>
      </div>
    </section>

    <section class="animate-in slide-in-from-bottom-10 duration-700">
      <div class="magic-card p-8 md:p-10">
        <div class="mb-8 text-center">
          <h3 class="text-2xl font-bold text-white">ចូលប្រើប្រាស់</h3>
          <p class="text-slate-400 text-sm mt-2">
            សូមជ្រើសរើសវិធីសាស្ត្រណាមួយខាងក្រោម
          </p>
        </div>

        <div class="space-y-5">
          <button
            onclick="signInWithGoogle()"
            id="googleBtn"
            class="btn-google"
          >
            <img
              src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
              class="w-5 h-5"
              alt="Google"
            />
            <span>បន្តជាមួយ Google</span>
          </button>

          <div class="flex items-center gap-3 my-6">
            <div class="h-px flex-1 bg-white/10"></div>
            <span class="text-xs text-slate-500 uppercase font-medium"
              >ឬ ប្រើអ៊ីមែល</span
            >
            <div class="h-px flex-1 bg-white/10"></div>
          </div>

          <div class="space-y-4">
            <div class="input-group">
              <label for="email">អ៊ីមែល (Email)</label>
              <input
                type="email"
                id="email"
                class="input-magic"
                placeholder="ឈ្មោះ@ឧទាហរណ៍.com"
              />
            </div>

            <div class="input-group">
              <label for="password">លេខសម្ងាត់ (Password)</label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  class="input-magic"
                  placeholder="បញ្ចូលលេខសម្ងាត់"
                />
                <button
                  onclick="togglePassword()"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white transition-colors"
                >
                  <span id="eye-icon">👁️</span>
                </button>
              </div>
            </div>
          </div>

          <button
            onclick="handleAuth()"
            id="authBtn"
            class="btn-primary-custom mt-2"
          >
            ចូលទៅកាន់ប្រព័ន្ធ
          </button>

          <p class="text-center text-sm text-slate-400 mt-6">
            មិនទាន់មានគណនីមែនទេ?
            <a
              href="/register"
              class="text-cyan-400 font-bold hover:text-cyan-300 transition-colors ml-1"
              >ចុះឈ្មោះនៅទីនេះ</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>
</div>

<%- include('partials/footer') %>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import {
    getAuth,
    signInWithEmailAndPassword,
    GoogleAuthProvider,
    signInWithPopup,
  } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "<%= firebaseConfig.apiKey %>",
    authDomain: "<%= firebaseConfig.authDomain %>",
    projectId: "<%= firebaseConfig.projectId %>",
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // ១. Background Animation (ធ្វើឱ្យទន់ភ្លន់ជាងមុន)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 50; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        size: Math.random() * 2,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#22d3ee' %>";
    ctx.strokeStyle = "rgba(255, 255, 255, 0.03)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;

      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 180) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }

  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Password Toggle
  window.togglePassword = () => {
    const passInput = document.getElementById("password");
    const eye = document.getElementById("eye-icon");
    if (passInput.type === "password") {
      passInput.type = "text";
      eye.innerText = "🔒";
    } else {
      passInput.type = "password";
      eye.innerText = "👁️";
    }
  };

  // ៣. Google Login
  window.signInWithGoogle = async () => {
    const googleBtn = document.getElementById("googleBtn");
    const originalText = googleBtn.innerHTML;
    googleBtn.innerHTML = "<span>កំពុងតភ្ជាប់...</span>";
    googleBtn.style.opacity = "0.7";
    googleBtn.style.pointerEvents = "none";

    try {
      const result = await signInWithPopup(auth, provider);
      await sendTokenToBackend(result.user);
    } catch (error) {
      googleBtn.innerHTML = originalText;
      googleBtn.style.opacity = "1";
      googleBtn.style.pointerEvents = "all";
      showError("ការតភ្ជាប់ជាមួយ Google បរាជ័យ!");
    }
  };

  // ៤. Email Login
  window.handleAuth = async () => {
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;
    const btn = document.getElementById("authBtn");

    if (!email || !password) {
      return Swal.fire({
        text: "បំពេញអ៊ីមែល និងលេខសម្ងាត់ផងបងប្រូ!",
        icon: "warning",
        confirmButtonColor: "#22d3ee",
      });
    }

    btn.innerText = "កំពុងត្រួតពិនិត្យ...";
    btn.classList.add("pointer-events-none", "opacity-70");

    try {
      const userCredential = await signInWithEmailAndPassword(
        auth,
        email,
        password,
      );
      await sendTokenToBackend(userCredential.user);
    } catch (error) {
      btn.innerText = "ចូលទៅកាន់ប្រព័ន្ធ";
      btn.classList.remove("pointer-events-none", "opacity-70");
      showError("អូហូ! រកគណនីមិនឃើញទេ ឬលេខសម្ងាត់ខុសបាត់ហើយ!");
    }
  };

  async function sendTokenToBackend(user) {
    const idToken = await user.getIdToken();
    const res = await fetch("/api/auth/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ idToken }),
    });

    if (res.ok) {
      window.location.href = "/dashboard";
    } else if (res.status === 404) {
      Swal.fire({
        icon: "info",
        title: "មិនទាន់មានគណនី",
        text: "អ៊ីមែលនេះមិនទាន់បានចុះឈ្មោះក្នុងប្រព័ន្ធយើងទេ ចុះឈ្មោះមួយសិនមក!",
        background: "#1e293b",
        color: "#fff",
        confirmButtonText: "ទៅចុះឈ្មោះ",
        confirmButtonColor: "#6366f1",
      }).then(() => {
        window.location.href = "/register";
      });
    } else {
      const data = await res.json();
      showError(data.message || "មានបញ្ហាបច្ចេកទេសបន្តិចបន្តួច!");
    }
  }

  function showError(msg) {
    Swal.fire({
      icon: "error",
      title: "មានបញ្ហា!",
      text: msg,
      background: "#1e293b",
      color: "#fff",
      confirmButtonColor: "#ef4444",
    });
  }
</script>
