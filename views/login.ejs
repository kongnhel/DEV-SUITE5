<%- include('partials/header') %>

<style>
  :root {
    --primary: <%= theme || "#22d3ee" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.6);
    --border-light: rgba(255, 255, 255, 0.1);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f8fafc;
    margin: 0;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ១. Background បែបស្ងប់ស្ងាត់ */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.1;
    pointer-events: none;
  }

  /* ២. Layout ពុះជាពីរ (Split Screen) */
  .auth-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .main-auth-card {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 1100px;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    border-radius: 32px;
    border: 1px solid var(--border-light);
    overflow: hidden;
    box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 1024px) {
    .main-auth-card {
      grid-template-columns: 1.1fr 0.9fr;
      min-height: 650px;
    }
  }

  /* ផ្នែករូបភាព (Visual Side) */
  .auth-visual-side {
    position: relative;
    background:
      linear-gradient(rgba(15, 23, 42, 0.4), rgba(15, 23, 42, 0.4)),
      url("images/2.png"); /* រូបភាព AI ថ្លៃថ្នូរ */
    background-size: cover;
    background-position: center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
  }

  .promote-text-box {
    background: rgba(15, 23, 42, 0.7);
    backdrop-filter: blur(10px);
    padding: 25px;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* ផ្នែក Form (Form Side) */
  .auth-form-side {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* ៣. Styling Inputs & Buttons */
  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 8px;
    margin-left: 4px;
    text-transform: uppercase;
  }

  .input-magic {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    color: white !important;
    padding: 1.1rem 1.4rem !important;
    border-radius: 18px !important;
    width: 100%;
    outline: none;
    transition: all 0.3s ease;
  }

  .input-magic:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.15);
  }

  .btn-primary-custom {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #0f172a;
    font-weight: 800;
    padding: 1.1rem;
    border-radius: 18px;
    width: 100%;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 10px 20px -5px rgba(34, 211, 238, 0.3);
  }

  .btn-primary-custom:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 30px -10px rgba(34, 211, 238, 0.4);
  }

  .btn-google {
    background: white;
    color: #1e293b;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 1rem;
    border-radius: 18px;
    width: 100%;
    border: 1px solid #e2e8f0;
    transition: all 0.3s ease;
  }

  .btn-google:hover {
    background: #f8fafc;
  }
</style>

<canvas id="neural-bg"></canvas>

<div class="auth-container">
  <main class="main-auth-card animate-in fade-in duration-1000">
    <section class="auth-visual-side hidden lg:flex">
      <div class="promote-text-box">
        <h2 class="text-3xl font-black text-white mb-3">Royal Cyber AI</h2>
        <p class="text-slate-200 text-lg font-light italic leading-relaxed">
          "រៀនឱ្យឆ្លាត យល់ឱ្យច្បាស់! ចូលរួមជាមួយ
          <span class="text-cyan-400 font-bold">Evolution</span>
          ដើម្បីបើកពិភពមន្តអាគម AI ផ្ទាល់ខ្លួនរបស់អ្នក។"
        </p>
      </div>
    </section>

    <section class="auth-form-side">
      <div class="w-full max-w-md mx-auto">
        <div class="text-center mb-10">
          <h1
            class="text-3xl md:text-4xl font-extrabold shimmer-text uppercase"
          >
            ចូលប្រើប្រាស់
          </h1>
          <p class="text-slate-400 text-sm mt-3">
            ស្វាគមន៍ត្រលប់មកវិញមិត្តសម្លាញ់!
          </p>
        </div>

        <div class="space-y-6">
          <button
            onclick="signInWithGoogle()"
            id="googleBtn"
            class="btn-google"
          >
            <img
              src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
              class="w-5 h-5"
              alt="Google"
            />
            <span>បន្តជាមួយ Google</span>
          </button>

          <div class="flex items-center gap-3 py-2">
            <div class="h-px flex-1 bg-white/10"></div>
            <span
              class="text-[10px] text-slate-500 uppercase font-black tracking-widest"
              >ឬ ប្រើអ៊ីមែល</span
            >
            <div class="h-px flex-1 bg-white/10"></div>
          </div>

          <div class="space-y-5">
            <div class="input-group">
              <label>អាសយដ្ឋានអ៊ីមែល</label>
              <input
                type="email"
                id="email"
                class="input-magic"
                placeholder="name@example.com"
              />
            </div>

            <div class="input-group">
              <label>លេខសម្ងាត់</label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  class="input-magic"
                  placeholder="បញ្ចូលលេខសម្ងាត់"
                />
                <button
                  onclick="togglePassword()"
                  class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-500 hover:text-white transition-colors"
                >
                  <span id="eye-icon">👁️</span>
                </button>
              </div>
            </div>
          </div>

          <button
            onclick="handleAuth()"
            id="authBtn"
            class="btn-primary-custom mt-2"
          >
            បញ្ជូនសញ្ញាចូលប្រព័ន្ធ
          </button>

          <div class="grid grid-cols-2 gap-4 mt-8">
            <div class="flex items-center gap-2 text-slate-400">
              <span class="text-lg">🔐</span>
              <span class="text-[10px] uppercase font-bold tracking-tighter"
                >សុវត្ថិភាពខ្ពស់</span
              >
            </div>
            <div class="flex items-center gap-2 text-slate-400">
              <span class="text-lg">🧠</span>
              <span class="text-[10px] uppercase font-bold tracking-tighter"
                >ការចងចាំឆ្លាតវៃ</span
              >
            </div>
          </div>

          <p class="text-center text-sm text-slate-500 mt-8">
            មិនទាន់មានគណនីមែនទេ?
            <a
              href="/register"
              class="text-cyan-400 font-bold hover:underline ml-1"
              >ចុះឈ្មោះនៅទីនេះ</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>
</div>

<%- include('partials/footer') %>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
  import {
    getAuth,
    signInWithEmailAndPassword,
    GoogleAuthProvider,
    signInWithPopup,
  } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "<%= firebaseConfig.apiKey %>",
    authDomain: "<%= firebaseConfig.authDomain %>",
    projectId: "<%= firebaseConfig.projectId %>",
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // ១. Background Particle Animation (យឺតៗ ស្ងប់ស្ងាត់)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 40; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#22d3ee' %>";
    ctx.strokeStyle = "rgba(255, 255, 255, 0.03)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 150) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Password Logic
  window.togglePassword = () => {
    const passInput = document.getElementById("password");
    const eye = document.getElementById("eye-icon");
    if (passInput.type === "password") {
      passInput.type = "text";
      eye.innerText = "🔒";
    } else {
      passInput.type = "password";
      eye.innerText = "👁️";
    }
  };

  // ៣. Auth Handlers
  window.signInWithGoogle = async () => {
    const googleBtn = document.getElementById("googleBtn");
    const originalText = googleBtn.innerHTML;
    googleBtn.innerHTML = "<span>កំពុងតភ្ជាប់...</span>";
    try {
      const result = await signInWithPopup(auth, provider);
      await sendTokenToBackend(result.user);
    } catch (error) {
      googleBtn.innerHTML = originalText;
      Swal.fire({
        text: "ការតភ្ជាប់បរាជ័យ!",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }
  };

  window.handleAuth = async () => {
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;
    const btn = document.getElementById("authBtn");
    if (!email || !password)
      return Swal.fire({
        text: "បំពេញឱ្យគ្រប់សិនបងប្រូ!",
        icon: "warning",
        confirmButtonColor: "#22d3ee",
      });

    btn.innerText = "កំពុងពិនិត្យ...";
    btn.classList.add("pointer-events-none", "opacity-70");
    try {
      const userCredential = await signInWithEmailAndPassword(
        auth,
        email,
        password,
      );
      await sendTokenToBackend(userCredential.user);
    } catch (error) {
      btn.innerText = "បញ្ជូនសញ្ញាចូលប្រព័ន្ធ";
      btn.classList.remove("pointer-events-none", "opacity-70");
      Swal.fire({
        text: "អ៊ីមែល ឬលេខសម្ងាត់មិនត្រឹមត្រូវ!",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }
  };

  async function sendTokenToBackend(user) {
    const idToken = await user.getIdToken();
    const res = await fetch("/api/auth/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ idToken }),
    });
    if (res.ok) window.location.href = "/dashboard";
    else {
      const data = await res.json();
      Swal.fire({
        text: data.message || "មានបញ្ហាបច្ចេកទេស!",
        icon: "error",
        background: "#1e293b",
        color: "#fff",
      });
    }
  }
</script>
