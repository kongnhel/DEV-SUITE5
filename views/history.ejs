<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Kantumruy+Pro:wght@300;400;700&display=swap" rel="stylesheet">

<style>
    :root { 
        --primary: <%= theme || '#a855f7' %>; 
        --bg-dark: #0b1121; /* Darker background like VS Code */
        --card-bg: #1e293b; /* Slate-800 */
        --input-bg: #0f172a; /* Slate-900 */
        --border-color: #334155;
        --text-main: #e2e8f0;
        --text-muted: #94a3b8;
        --danger: #ef4444;
    }
    
    body { 
        font-family: "Kantumruy Pro", sans-serif; 
        background-color: var(--bg-dark); 
        color: var(--text-main); 
        margin: 0; 
        /* Keeping a subtle gradient */
        background-image: radial-gradient(circle at center, #1e293b 0%, #0b1121 100%);
        min-height: 100vh;
    }

    /* Background Canvas logic kept but adjusted z-index */
    #neural-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -20; opacity: 0.15; pointer-events: none; }

    /* Scrollbar Customization */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-dark); }
    ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--primary); }

    /* Search Dock Styling (New Design) */
    .search-dock {
        background: rgba(30, 41, 59, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 0.75rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    }

    .input-ide {
        background: var(--input-bg) !important;
        border: 1px solid var(--border-color) !important;
        color: white !important;
        font-family: "Kantumruy Pro", sans-serif;
        border-radius: 8px !important;
        transition: all 0.3s ease;
    }
    .input-ide:focus {
        border-color: var(--primary) !important;
        outline: none;
        box-shadow: 0 0 0 2px rgba(168, 85, 247, 0.2);
    }

    /* Result Card Styling (IDE Panel Style) */
    .ide-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s;
        margin-bottom: 2rem;
    }
    .ide-card:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
    }

    /* 🔥 THE FIX: Code Block Styling with Scrollbar 🔥 */
    .prose pre {
        background-color: #0f172a !important;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 1rem;
        font-family: 'JetBrains Mono', monospace;
        margin-top: 10px;
        margin-bottom: 10px;
        
        /* Key Properties for Scrolling */
        overflow-x: auto;
        max-width: 100%;
        white-space: pre;
    }
    /* Scrollbar specific for Code Blocks */
    .prose pre::-webkit-scrollbar { height: 8px; }
    .prose pre::-webkit-scrollbar-track { background: #0f172a; border-radius: 4px; }
    .prose pre::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    .prose pre::-webkit-scrollbar-thumb:hover { background: var(--primary); }

    .prose code {
        color: #38bdf8;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9em;
    }
    .prose h3 { color: #f472b6; font-weight: 700; margin-top: 1.5rem; }
    .prose p { color: #cbd5e1; line-height: 1.6; }
    .prose ul { list-style-type: disc; padding-left: 1.5rem; color: #cbd5e1; }

    /* Custom Badges */
    .badge-pill {
        font-size: 10px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 20px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }
</style>

<canvas id="neural-bg"></canvas>

<main class="max-w-5xl mx-auto px-4 py-8 relative">
    
    <header class="text-center mb-10">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-2 tracking-tighter uppercase italic">Dev <span style="color: var(--primary)">Logs</span></h2>
        <p class="text-slate-500 text-sm font-mono">"Memory Vault: រុករកដានជើងកូដនិងការសន្ទនា"</p>
    </header>

    <div class="sticky top-6 z-50 mb-12">
        <div class="search-dock max-w-4xl mx-auto">
            <form action="/history" method="GET" class="flex flex-col md:flex-row gap-3">
                <div class="flex-grow relative">
                    <input type="text" name="search" value="<%= currentSearch %>" class="input-ide w-full px-4 py-3 text-sm" placeholder="ស្វែងរកតាមពាក្យគន្លឹះ (Search Query)...">
                </div>
                
                <div class="md:w-1/3">
                    <select name="tool" class="input-ide w-full px-4 py-3 text-xs font-bold uppercase cursor-pointer">
                        <option value="ALL" <%= currentTool === 'ALL' ? 'selected' : '' %>>ALL TOOLS</option>
                        <option value="ARCHITECT_AI" <%= currentTool === 'ARCHITECT_AI' ? 'selected' : '' %>>🏗️ Architect</option>
                        <option value="LOVE_HEALER_RAGE" <%= currentTool === 'LOVE_HEALER_RAGE' ? 'selected' : '' %>>🔥 Love Healer</option>
                        <option value="CODE_REVIEWER" <%= currentTool === 'CODE_REVIEWER' ? 'selected' : '' %>>💻 Code Reviewer</option>
                        <option value="STUDY_ASSISTANT" <%= currentTool === 'STUDY_ASSISTANT' ? 'selected' : '' %>>📖 Study Buddy</option>
                        <option value="KHMER_CULTURE" <%= currentTool === 'KHMER_CULTURE' ? 'selected' : '' %>>🏯 Culture Sage</option>
                        <option value="K_IDA" <%= currentTool === 'K_IDA' ? 'selected' : '' %>>📄 K-IDA Docs</option>
                    </select>
                </div>

                <button type="submit" class="bg-purple-600 hover:bg-purple-500 text-white px-6 py-3 rounded-lg font-bold text-sm transition-all shadow-lg shadow-purple-500/20 whitespace-nowrap uppercase tracking-widest">
                    ស្វែងរក
                </button>
            </form>
        </div>
    </div>

    <div class="space-y-6">
        <% if (history.length > 0) { %>
            <% history.forEach(item => { %>
                <div class="ide-card group" id="card-<%= item._id %>">
                    <div class="bg-[#0f172a] p-5 border-b border-slate-700 flex justify-between items-start relative">
                        <div class="flex-1 pr-10">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
                                <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">User Input</span>
                            </div>
                            <p class="text-sm md:text-base text-white font-medium italic">"<%= item.userInput %>"</p>
                            
                            <% if (item.userImage) { %>
                                <div class="mt-3">
                                    <img src="data:image/jpeg;base64,<%= item.userImage %>" class="h-24 w-auto rounded border border-slate-600 cursor-zoom-in hover:opacity-80 transition" alt="Uploaded">
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="absolute top-4 right-4">
                            <button onclick="confirmDelete('<%= item._id %>')" class="text-slate-600 hover:text-red-500 transition-colors p-2" title="លុបចោល">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                            </button>
                        </div>
                    </div>

                    <div class="p-6 bg-[#1e293b]">
                        <div class="flex flex-wrap items-center gap-3 mb-6">
                            <% 
                                let badgeClass = "bg-slate-700 text-slate-300";
                                if(item.toolName.includes('LOVE')) badgeClass = "bg-rose-500/20 text-rose-300 border border-rose-500/30";
                                if(item.toolName.includes('CODE')) badgeClass = "bg-cyan-500/20 text-cyan-300 border border-cyan-500/30";
                                if(item.toolName.includes('ARCHITECT')) badgeClass = "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
                                if(item.toolName.includes('CULTURE')) badgeClass = "bg-yellow-500/20 text-yellow-300 border border-yellow-500/30";
                            %>
                            <span class="badge-pill <%= badgeClass %>">
                                <%= item.toolName %>
                            </span>
                            <span class="text-[10px] font-mono text-slate-500">
                                <%= new Date(item.createdAt).toLocaleString('km-KH') %>
                            </span>
                        </div>

                        <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest mb-2">SYSTEM OUTPUT:</div>
                        <div id="content-<%= item._id %>" class="prose prose-invert max-w-none text-sm md:text-base"></div>
                        
                        <script>
                            (function() {
                                const rawRes = <%- JSON.stringify(item.aiResponse) %>;
                                let text = "";
                                if (typeof rawRes === 'string') {
                                    text = rawRes;
                                } else {
                                    if (rawRes.plan_title && rawRes.overview) {
                                        text = `### ${rawRes.plan_title}\n\n${rawRes.overview}`;
                                    } else {
                                        text = rawRes.plan_title || rawRes.response || rawRes.explanation || rawRes.answer || rawRes.summary || "រួចរាល់។";
                                    }
                                }
                                document.getElementById("content-<%= item._id %>").innerHTML = marked.parse(text);
                            })();
                        </script>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="ide-card p-20 text-center opacity-60">
                <div class="text-6xl mb-6">🕳️</div>
                <h3 class="text-xl font-mono font-bold text-slate-400 uppercase">NO LOGS FOUND</h3>
                <p class="text-slate-600 text-sm mb-6">System is empty.</p>
                <a href="/" class="inline-block px-8 py-3 bg-purple-600/20 border border-purple-500/50 text-purple-300 rounded-lg font-bold text-xs uppercase hover:bg-purple-600 hover:text-white transition-all">Start New Thread</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>

<script>
    // ១. Deletion Logic (រក្សា Logic ដើម ដូរតែ Design Alert)
    function confirmDelete(id) {
        Swal.fire({
            title: 'Delete Data?',
            text: "ទិន្នន័យនេះនឹងត្រូវលុបជាអចិន្ត្រៃយ៍!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#334155',
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel',
            background: '#0f172a',
            color: '#e2e8f0'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/history/${id}`, { method: 'DELETE' })
                .then(res => {
                    if(res.ok) {
                        const card = document.getElementById(`card-${id}`);
                        card.style.transition = 'all 0.3s ease';
                        card.style.transform = 'scale(0.95)';
                        card.style.opacity = '0';
                        setTimeout(() => card.remove(), 300);
                        
                        const Toast = Swal.mixin({
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000,
                            background: '#1e293b',
                            color: '#fff'
                        })
                        Toast.fire({ icon: 'success', title: 'Deleted Successfully' })
                    } else {
                        Swal.fire('Error!', 'បរាជ័យក្នុងការលុប។', 'error');
                    }
                })
                .catch(err => Swal.fire('Error!', 'Server Error.', 'error'));
            }
        })
    }

    // ២. Background Animation (រក្សាទុកឱ្យ Boss គ្រាន់តែបន្ថយ Opacity ឱ្យស៊ីនឹង Dark Mode)
    const canvas = document.getElementById("neural-bg");
    const ctx = canvas.getContext("2d");
    let dots = [];
    function init() {
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        dots = []; const count = window.innerWidth < 768 ? 20 : 40;
        for (let i = 0; i < count; i++) { dots.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2, size: Math.random() * 1.5 }); }
    }
    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "<%= theme || '#a855f7' %>";
        dots.forEach(d => {
            d.x += d.vx; d.y += d.vy;
            if (d.x < 0 || d.x > canvas.width) d.vx *= -1; if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
            ctx.beginPath(); ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2); ctx.fill();
        });
        requestAnimationFrame(draw);
    }
    init(); draw(); window.addEventListener("resize", init);
</script>