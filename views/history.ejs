<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root { 
        --primary: <%= theme || '#a855f7' %>; 
        --secondary: #6366f1;
        --bg-dark: #0f172a; 
        --card-bg: rgba(30, 41, 59, 0.6);
        --border-light: rgba(255, 255, 255, 0.1);
        --danger: #ef4444;
    }
    
    body { font-family: "Kantumruy Pro", sans-serif; background-color: var(--bg-dark); color: #e2e8f0; margin: 0; }
    #neural-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -20; opacity: 0.15; pointer-events: none; }
    .bg-grid { position: fixed; inset: 0; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.01) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.01) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(circle at 50% 50%, black, transparent 95%); z-index: -10; }

    .magic-card { background: var(--card-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-radius: 24px; border: 1px solid var(--border-light); transition: 0.3s; }
    .magic-card:hover { border-color: var(--primary); transform: translateY(-2px); }

    .search-container { background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(20px); border: 1px solid var(--border-light); border-radius: 20px; padding: 1.5rem; }
    .input-custom { background: rgba(0, 0, 0, 0.3) !important; border: 1px solid var(--border-light) !important; border-radius: 12px !important; color: white !important; padding: 0.75rem 1rem !important; }

    /* Tool Color Badges */
    .badge-love { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); }
    .badge-culture { background: rgba(212, 175, 55, 0.1); color: #d4af37; border: 1px solid rgba(212, 175, 55, 0.2); }
    .badge-code { background: rgba(34, 211, 238, 0.1); color: #22d3ee; border: 1px solid rgba(34, 211, 238, 0.2); }
    .badge-architect { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }

    .shimmer-text { background: linear-gradient(90deg, #fff, var(--primary), #fff); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 8s linear infinite; }
    @keyframes shine { to { background-position: 200% center; } }

    .history-img { max-width: 150px; border-radius: 12px; border: 1px solid var(--border-light); margin-top: 10px; cursor: zoom-in; }
    
    .btn-delete { color: #64748b; transition: 0.3s; cursor: pointer; }
    .btn-delete:hover { color: var(--danger); transform: scale(1.1); }
</style>

<canvas id="neural-bg"></canvas>
<div class="bg-grid"></div>

<main class="max-w-6xl mx-auto px-6 py-12 relative">
    <header class="text-center mb-12">
        <h2 class="text-4xl md:text-6xl font-black shimmer-text mb-4 uppercase italic">Memory Vault</h2>
        <p class="text-slate-400 text-lg font-light italic">"រុករករាល់ដានជើងនៃការសន្ទនាដែលបងធ្លាប់បានឆ្លងកាត់"</p>
    </header>

    <div class="search-container mb-12 shadow-xl sticky top-4 z-50">
        <form action="/history" method="GET" class="grid grid-cols-1 lg:grid-cols-12 gap-4">
            <div class="lg:col-span-5">
                <input type="text" name="search" value="<%= currentSearch %>" class="input-custom w-full" placeholder="ស្វែងរកតាមពាក្យគន្លឹះ...">
            </div>
            
            <div class="lg:col-span-4">
                <select name="tool" class="input-custom w-full cursor-pointer text-xs font-bold uppercase tracking-widest">
                    <option value="ALL" <%= currentTool === 'ALL' ? 'selected' : '' %>>គ្រប់ផ្នែកទាំងអស់ (All Tools)</option>
                    <option value="ARCHITECT_AI" <%= currentTool === 'ARCHITECT_AI' ? 'selected' : '' %>>🏗️ Architect AI</option>
                    <option value="LOVE_HEALER_RAGE" <%= currentTool === 'LOVE_HEALER_RAGE' ? 'selected' : '' %>>🔥 Love Healer</option>
                    <option value="CODE_REVIEWER" <%= currentTool === 'CODE_REVIEWER' ? 'selected' : '' %>>💻 Code Reviewer</option>
                    <option value="STUDY_ASSISTANT" <%= currentTool === 'STUDY_ASSISTANT' ? 'selected' : '' %>>📖 Study Buddy</option>
                    <option value="KHMER_CULTURE" <%= currentTool === 'KHMER_CULTURE' ? 'selected' : '' %>>🏯 Culture Sage</option>
                    <option value="K_IDA" <%= currentTool === 'K_IDA' ? 'selected' : '' %>>📄 K-IDA Docs</option>
                </select>
            </div>

            <div class="lg:col-span-3">
                <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white py-3 rounded-xl font-bold text-xs hover:opacity-90 transition-all uppercase tracking-widest shadow-lg shadow-indigo-500/20">ស្វែងរកទិន្នន័យ</button>
            </div>
        </form>
    </div>

    <div class="space-y-8">
        <% if (history.length > 0) { %>
            <% history.forEach(item => { %>
                <div class="magic-card p-6 md:p-10 relative group" id="card-<%= item._id %>">
                    <div class="absolute top-6 right-6 opacity-0 group-hover:opacity-100 transition-opacity">
                        <span onclick="confirmDelete('<%= item._id %>')" class="btn-delete text-xl" title="លុបចោល">🗑️</span>
                    </div>

                    <div class="flex flex-wrap items-center gap-4 mb-8 border-b border-white/5 pb-4">
                        <% 
                           let badgeClass = "bg-purple-500/10 text-purple-400";
                           if(item.toolName.includes('LOVE')) badgeClass = "badge-love";
                           if(item.toolName.includes('CULTURE')) badgeClass = "badge-culture";
                           if(item.toolName.includes('CODE')) badgeClass = "badge-code";
                           if(item.toolName.includes('ARCHITECT')) badgeClass = "badge-architect";
                        %>
                        <span class="px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest <%= badgeClass %>">
                            <%= item.toolName %>
                        </span>
                        <span class="text-slate-500 text-[10px] font-mono italic">
                            <%= new Date(item.createdAt).toLocaleString('km-KH') %>
                        </span>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                        <div class="lg:col-span-4">
                            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3">ចម្ងល់របស់បង</div>
                            <p class="text-lg text-white font-medium italic">"<%= item.userInput %>"</p>
                            
                            <% if (item.userImage) { %>
                                <img src="data:image/jpeg;base64,<%= item.userImage %>" class="history-img" alt="Uploaded Image">
                            <% } %>
                        </div>

                        <div class="lg:col-span-8">
                            <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest mb-3">ការបកស្រាយពី AI</div>
                            <div id="content-<%= item._id %>" class="prose prose-invert max-w-none text-slate-300 leading-relaxed"></div>
                            
                            <script>
                                (function() {
                                    const rawRes = <%- JSON.stringify(item.aiResponse) %>;
                                    let text = "";
                                    
                                    if (typeof rawRes === 'string') {
                                        text = rawRes;
                                    } else {
                                        // ឆែកមើលគ្រប់លទ្ធភាពនៃ Response Object (រួមទាំង ARCHITECT_AI)
                                        if (rawRes.plan_title && rawRes.overview) {
                                            text = `### ${rawRes.plan_title}\n\n${rawRes.overview}`;
                                        } else {
                                            text = rawRes.plan_title || rawRes.response || rawRes.explanation || rawRes.answer || rawRes.summary || "រួចរាល់។";
                                        }
                                    }
                                    
                                    document.getElementById("content-<%= item._id %>").innerHTML = marked.parse(text);
                                })();
                            </script>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="magic-card p-20 text-center">
                <div class="text-6xl mb-6 opacity-20">🕳️</div>
                <h3 class="text-xl font-bold text-slate-500 uppercase">រកមិនឃើញដានជើងទេ</h3>
                <a href="/" class="mt-8 inline-block px-8 py-3 bg-purple-600 text-white rounded-xl font-bold text-xs uppercase hover:bg-purple-500 transition-all">ចាប់ផ្ដើមសួរ AI ឥឡូវនេះ</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>

<script>
    // ១. Deletion Logic (កែសម្រួល URL ឱ្យត្រូវនឹង Route Backend បង)
    function confirmDelete(id) {
        Swal.fire({
            title: 'តើបងច្បាស់ទេ?',
            text: "ចង់លុបដានជើងនៃការសន្ទនានេះចោលមែនទេ? លុបហើយយកវិញអត់បានទេណា!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#a855f7',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'បាទ! លុបចោលទៅ',
            cancelButtonText: 'កុំអី លួចទុកមើលម្នាក់ឯង',
            background: '#0f172a',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                // បាញ់ទៅ API លុប (ត្រូវប្រាកដថាបងមាន Route: DELETE /history/:id)
                fetch(`/history/${id}`, { method: 'DELETE' })
                .then(res => {
                    if(res.ok) {
                        const card = document.getElementById(`card-${id}`);
                        card.style.transform = 'scale(0.9)';
                        card.style.opacity = '0';
                        setTimeout(() => card.remove(), 300);
                        Swal.fire({
                            title: 'លុបរួចរាល់!',
                            text: 'ដានជើងនេះត្រូវបានកម្ចាត់ចេញពី Memory Vault ហើយ។',
                            icon: 'success',
                            background: '#0f172a',
                            color: '#fff',
                            timer: 1500,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Error!', 'មិនអាចលុបទិន្នន័យបានទេ សាកម្ដងទៀតបង!', 'error');
                    }
                })
                .catch(err => Swal.fire('Error!', 'Server មានបញ្ហាហើយបងប្រុស!', 'error'));
            }
        })
    }

    // ២. Background Animation (Neural Connectors)
    const canvas = document.getElementById("neural-bg");
    const ctx = canvas.getContext("2d");
    let dots = [];
    function init() {
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        dots = []; const count = window.innerWidth < 768 ? 20 : 40;
        for (let i = 0; i < count; i++) { dots.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2, size: Math.random() * 1.5 }); }
    }
    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "<%= theme || '#a855f7' %>";
        dots.forEach(d => {
            d.x += d.vx; d.y += d.vy;
            if (d.x < 0 || d.x > canvas.width) d.vx *= -1; if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
            ctx.beginPath(); ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2); ctx.fill();
        });
        requestAnimationFrame(draw);
    }
    init(); draw(); window.addEventListener("resize", init);
</script>