<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --primary: <%= theme || "#6366f1" %>;
    --secondary: #818cf8;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.1);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.6;
  }

  /* ១. Background បែបស្ងប់ស្ងាត់ ជួយឱ្យផ្ដោតអារម្មណ៍រៀន */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.1;
    pointer-events: none;
  }

  /* ២. Card Design៖ សាមញ្ញ ថ្លៃថ្នូរ និងមានសណ្ដាប់ធ្នាប់ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 28px;
    border: 1px solid var(--border-light);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    transition: all 0.3s ease;
  }

  /* ៣. Input Styles */
  .big-input {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 20px !important;
    color: white !important;
    padding: 1.5rem !important;
    width: 100%;
    outline: none;
    font-size: 1.1rem;
    line-height: 1.8;
    transition: all 0.3s ease;
  }

  .big-input:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
  }

  /* ៤. Button Styles */
  .btn-study {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: white;
    font-weight: 700;
    padding: 1.2rem;
    border-radius: 20px;
    width: 100%;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .btn-study:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.4);
  }

  /* ៥. Result Text Style */
  .summary-box {
    border-left: 8px solid var(--primary);
    background: rgba(255, 255, 255, 0.03);
    padding: 2.5rem;
    border-radius: 24px;
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
  }
</style>

<canvas id="neural-bg"></canvas>

<main class="max-w-7xl mx-auto px-6 py-12 relative">
  <header class="text-center mb-16 animate-in fade-in duration-700">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 mb-8"
    >
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span
        class="text-indigo-400 text-[10px] font-bold uppercase tracking-widest"
        >AI Learning Assistant</span
      >
    </div>

    <h1
      class="text-5xl md:text-8xl font-black shimmer-text mb-8 uppercase italic leading-none"
    >
      STUDY BUDDY
    </h1>

    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xl md:text-3xl font-light text-slate-200 leading-snug">
        "រៀនឱ្យឆ្លាត មិនមែនរៀនឱ្យហត់! ហើយអំបិលដដែលដូចអត់រៀន ឱ្យបង AI ក្លាយជា
        <span class="text-indigo-400 font-bold">Assistant</span>
        ផ្ទាល់ខ្លួនរបស់អ្នក!"
      </p>
      <p class="text-slate-400 text-base md:text-lg italic leading-relaxed">
        បងធុញនឹងការអានមេរៀនច្រើនៗមែនទេ?
        <strong class="text-indigo-400">Study Buddy</strong>
        នឹងជួយបងសង្ខេបចំណុចសំខាន់ៗ និងបង្កើត Quiz
        ដើម្បីតេស្តខួរក្បាលបងភ្លាមៗ។ មិនថាជាមេរៀនវិទ្យាសាស្ត្រ
        ឬប្រវត្តិសាស្ត្រ បោះវាចូលមក ចាំអូនជួយសម្រួលឱ្យ "ភ្លឺភ្នែក" ហ្មង! 😂
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      <div class="magic-card p-8">
        <span class="feature-icon">📜</span>
        <h4 class="text-white font-bold mb-2 uppercase text-xs">សង្ខេបរហ័ស</h4>
        <p class="text-slate-400 text-xs font-light">
          បំប្លែងមេរៀនរាប់សិបទំព័រ ឱ្យមកនៅត្រឹមចំណុចខ្លឹមៗបំផុត។
        </p>
      </div>
      <div class="magic-card p-8">
        <span class="feature-icon">🧩</span>
        <h4 class="text-white font-bold mb-2 uppercase text-xs">
          តេស្តសមត្ថភាព
        </h4>
        <p class="text-slate-400 text-xs font-light">
          បង្កើតសំណួរ Quiz ភ្លាមៗ ដើម្បីជួយឱ្យបងចងចាំមេរៀនបានយូរ។
        </p>
      </div>
      <div class="magic-card p-8">
        <span class="feature-icon">🔥</span>
        <h4 class="text-white font-bold mb-2 uppercase text-xs">
          កម្លាំងចិត្ត
        </h4>
        <p class="text-slate-400 text-xs font-light">
          ទទួលបានពាក្យលើកទឹកចិត្តកំប្លែងៗ ដើម្បីឱ្យបងមានកម្លាំងរៀនបន្ត។
        </p>
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 md:gap-12 items-start">
    <section class="xl:col-span-5">
      <div class="magic-card p-8 md:p-10">
        <div class="flex items-center gap-4 mb-8">
          <span class="text-2xl">📥</span>
          <div>
            <h3 class="text-lg font-bold text-white uppercase tracking-tight">
              បញ្ចូលមេរៀន
            </h3>
            <p class="text-xs text-slate-500 uppercase">
              Input Knowledge Block
            </p>
          </div>
        </div>

        <textarea
          id="studyContent"
          class="big-input h-80 md:h-[450px] resize-none"
          placeholder="បិទភ្ជាប់អត្ថបទមេរៀនដែលប្អូនចង់ឱ្យបងជួយ... (ឧទាហរណ៍៖ ច្បាប់រូបវិទ្យា ឬ ប្រវត្តិសាស្ត្រ)"
        ></textarea>

        <button onclick="processStudy()" id="btnAction" class="btn-study mt-8">
          ចាប់ផ្ដើមបំប្លែងមេរៀន
        </button>
      </div>
    </section>

    <section class="xl:col-span-7">
      <div
        id="loading"
        class="hidden magic-card p-20 flex flex-col items-center justify-center"
      >
        <div
          class="w-12 h-12 border-4 border-white/5 border-t-indigo-500 rounded-full animate-spin mb-6"
        ></div>
        <p
          class="text-indigo-400 text-xs font-bold uppercase tracking-[0.3em] animate-pulse"
        >
          កំពុងវិភាគ និងសង្ខេបមេរៀន...
        </p>
      </div>

      <div id="resultArea" class="hidden space-y-8">
        <div class="summary-box">
          <h4
            class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.4em] mb-6 flex items-center gap-3"
          >
            <span class="h-px w-10 bg-indigo-500/30"></span> សេចក្ដីសង្ខេបមេរៀន
          </h4>
          <div
            id="summaryText"
            class="text-xl md:text-2xl font-light text-slate-200 leading-relaxed italic"
          ></div>
        </div>

        <div class="magic-card p-8 md:p-12">
          <h4
            class="text-[10px] font-black text-yellow-500 uppercase tracking-[0.4em] mb-10 flex items-center gap-3"
          >
            <span class="h-px w-10 bg-yellow-500/30"></span> Brain Test (Quiz)
          </h4>
          <div id="quizContainer" class="space-y-6"></div>
        </div>

        <div
          class="magic-card p-8 bg-indigo-500/5 border-indigo-500/20 text-center"
        >
          <span class="text-4xl mb-4 block">🙌</span>
          <p
            id="motivationText"
            class="text-lg md:text-xl text-indigo-300 font-medium italic"
          ></p>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  const socket = io();

  // ១. Background Animation (រង្វើល និងយឺត)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    const count = window.innerWidth < 768 ? 30 : 60;
    for (let i = 0; i < count; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#6366f1' %>";
    ctx.strokeStyle = "rgba(99, 102, 241, 0.04)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 150) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Study Logic
  function processStudy() {
    const content = document.getElementById("studyContent").value.trim();
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!content)
      return Swal.fire({
        text: "ដាក់មេរៀនឱ្យអូនមើលសិនបង​ កុំចង់រៀនកាត់! 😂",
        icon: "info",
        confirmButtonColor: "#6366f1",
      });
    if (!firebaseUid)
      return Swal.fire({
        text: "សូមចូលគណនីសិនបង!",
        icon: "warning",
        confirmButtonColor: "#6366f1",
      });

    document.getElementById("loading").classList.remove("hidden");
    document.getElementById("resultArea").classList.add("hidden");
    document.getElementById("btnAction").disabled = true;

    socket.emit("study_assist", { content, firebaseUid });
  }

  socket.on("study_result", (res) => {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("resultArea").classList.remove("hidden");
    document.getElementById("btnAction").disabled = false;

    typeWriter("summaryText", res.summary);
    document.getElementById("motivationText").innerText =
      "“ " + res.funny_motivation + " ”";

    const container = document.getElementById("quizContainer");
    container.innerHTML = "";
    res.quiz.forEach((q, idx) => {
      const card = document.createElement("div");
      card.className =
        "p-6 rounded-2xl bg-white/5 border border-white/5 space-y-4";
      card.innerHTML = `
        <p class="font-bold text-white text-lg italic"><span class="text-indigo-400">#${idx + 1}:</span> ${q.question}</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          ${q.options
            .map(
              (opt) => `
            <button onclick="checkAnswer(this, '${opt}', '${q.answer}')" class="text-left p-4 rounded-xl bg-black/30 border border-white/5 hover:bg-indigo-600/20 transition-all text-sm">
              ${opt}
            </button>
          `,
            )
            .join("")}
        </div>
      `;
      container.appendChild(card);
    });
    document
      .getElementById("resultArea")
      .scrollIntoView({ behavior: "smooth" });
  });

  function checkAnswer(btn, selected, correct) {
    const parent = btn.parentElement;
    if (selected === correct) {
      btn.classList.add("bg-emerald-500", "text-black", "border-emerald-400");
      btn.innerHTML += " ✨ (ត្រឹមត្រូវ!)";
    } else {
      btn.classList.add("bg-red-500", "text-white", "border-red-400");
      btn.innerHTML += " 💀 (ខុសហើយ!)";
    }
    parent.querySelectorAll("button").forEach((b) => (b.disabled = true));
  }

  function typeWriter(id, text) {
    let i = 0;
    const el = document.getElementById(id);
    el.innerHTML = "";
    function type() {
      if (i < text.length) {
        el.innerHTML += text.charAt(i);
        i++;
        setTimeout(type, 15);
      }
    }
    type();
  }
</script>
