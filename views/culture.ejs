<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link
  href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;700&display=swap"
  rel="stylesheet"
/>

<style>
  :root {
    --royal-gold: <%= theme || "#d4af37" %>;
    --gold-glow: rgba(212, 175, 55, 0.2);
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(212, 175, 55, 0.15);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.7;
  }

  /* ១. Background បែបថ្លៃថ្នូរ (Modern Khmer Heritage) */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.15;
    pointer-events: none;
  }

  .bg-pattern {
    position: fixed;
    inset: 0;
    background-image: url("https://www.transparenttextures.com/patterns/pinstriped-suit.png");
    opacity: 0.03;
    z-index: -15;
    pointer-events: none;
  }

  /* ២. Card Design៖ ស្អាត បែបសាមញ្ញ មិនឆើតឆាយ */
  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 28px;
    border: 1px solid var(--border-light);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    transition: all 0.3s ease;
  }

  .magic-card:hover {
    border-color: var(--royal-gold);
    background: rgba(30, 41, 59, 0.85);
  }

  /* ៣. Input & Dropdown Styles */
  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 24px !important;
    color: white !important;
    padding: 1.5rem !important;
    width: 100%;
    outline: none;
    font-size: 1.1rem;
    transition: all 0.3s ease;
  }

  .input-custom:focus {
    border-color: var(--royal-gold) !important;
    box-shadow: 0 0 0 4px var(--gold-glow) !important;
  }

  .select-custom {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-light);
    border-radius: 18px;
    color: var(--royal-gold);
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-weight: 600;
  }

  /* ៤. Button Styles */
  .btn-khmer {
    background: linear-gradient(135deg, #b8860b 0%, #ffd700 50%, #b8860b 100%);
    color: #0f172a !important;
    font-weight: 800;
    padding: 1.2rem 2.5rem;
    border-radius: 20px;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 1rem;
  }

  .btn-khmer:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px var(--gold-glow);
    filter: brightness(1.1);
  }

  /* ៥. Promote Page Styles */
  .shimmer-gold {
    background: linear-gradient(90deg, #ffd700, #fff, #ffd700);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 6s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .heritage-badge {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--border-light);
    color: var(--royal-gold);
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .prose-custom {
    line-height: 1.8;
    color: #cbd5e1;
    font-size: 1.1rem;
  }
  .prose-custom strong {
    color: var(--royal-gold);
  }
</style>

<canvas id="neural-bg"></canvas>
<div class="bg-pattern"></div>

<main class="max-w-7xl mx-auto px-6 py-12 relative">
  <header class="text-center mb-16 animate-in fade-in duration-1000">
    <div class="flex justify-center mb-6">
      <span class="heritage-badge">Ancient Wisdom x AI Intelligence</span>
    </div>

    <h2
      class="text-5xl md:text-8xl font-black shimmer-gold mb-8 uppercase italic leading-none"
    >
      មគ្គុទ្ទេសក៍វប្បធម៌
    </h2>

    <div class="max-w-3xl mx-auto space-y-6">
      <p class="text-xl md:text-3xl font-light text-slate-200 leading-snug">
        "បើកក្រាំងមាសនៃប្រវត្តិសាស្ត្រខ្មែរ តាមរយៈ <br />
        <span class="text-yellow-500 font-bold">មន្តអាគមឌីជីថល</span>!"
      </p>
      <p class="text-slate-400 text-base md:text-lg italic leading-relaxed">
        តើបងចង់ដឹងពីអាថ៌កំបាំងនៃប្រាសាទបុរាណ
        ឬទំនៀមទម្លាប់ខ្មែរដែលបាត់បង់មែនទេ?
        <strong class="text-yellow-600">AI Culture Guide</strong>
        នឹងក្លាយជាមគ្គុទ្ទេសក៍ឆ្លាតវៃ
        ចាំបកស្រាយរាល់ចម្ងល់វប្បធម៌ជូនបងយ៉ាងកំប្លែង និងស៊ីជម្រៅបំផុត។
        បោះចម្ងល់បងចូលមក ចាំអូនជួយចារក្នុងក្រាំងមាសឱ្យ! 😂
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12">
      <div class="magic-card p-8">
        <span class="text-4xl mb-4 block">🏯</span>
        <h4 class="text-yellow-500 font-bold mb-2 uppercase text-xs">
          ក្រាំងចំណេះដឹងបុរាណ
        </h4>
        <p class="text-slate-400 text-xs font-light">
          ទាញយកទិន្នន័យពីសម័យមហានគរ មកបង្ហាញក្នុងមួយពព្រិចភ្នែក។
        </p>
      </div>
      <div class="magic-card p-8">
        <span class="text-4xl mb-4 block">📜</span>
        <h4 class="text-yellow-500 font-bold mb-2 uppercase text-xs">
          អ្នកនិទានរឿងវៃឆ្លាត
        </h4>
        <p class="text-slate-400 text-xs font-light">
          ការបកស្រាយបែបមន្តអាគម ងាយយល់ និងមានតុងកំប្លែងៗ។
        </p>
      </div>
      <div class="magic-card p-8">
        <span class="text-4xl mb-4 block">✨</span>
        <h4 class="text-yellow-500 font-bold mb-2 uppercase text-xs">
          ការផ្ទៀងផ្ទាត់ច្បាស់លាស់
        </h4>
        <p class="text-slate-400 text-xs font-light">
          ប្រើ AI ដើម្បីផ្ទៀងផ្ទាត់ទិន្នន័យប្រវត្តិសាស្ត្រឱ្យបានត្រឹមត្រូវ។
        </p>
      </div>
    </div>
  </header>

  <div class="max-w-4xl mx-auto space-y-12">
    <section class="magic-card p-8 md:p-12 shadow-2xl">
      <textarea
        id="questionInput"
        class="input-custom h-40 md:h-52 resize-none no-scrollbar"
        placeholder="ឧទាហរណ៍៖ តើប្រាសាទអង្គរវត្តត្រូវបានកសាងឡើងក្នុងគោលបំណងអ្វី?"
      ></textarea>

      <div
        class="flex flex-col lg:flex-row items-center justify-between gap-8 mt-10"
      >
        <div class="w-full lg:w-1/2">
          <label
            class="block text-[10px] font-bold text-yellow-600 uppercase tracking-widest mb-3 ml-2"
            >របៀបបកស្រាយ (Wisdom Style)</label
          >
          <select id="answerType" class="input-custom py-4 !text-yellow-200">
            <option value="brief">✨ សង្ខេបខ្លី ខ្លឹម (Brief Wisdom)</option>
            <option value="detailed">📜 ពន្យល់លម្អិត (Ancient Archives)</option>
          </select>
        </div>

        <button
          onclick="askAI()"
          id="btnAsk"
          class="btn-khmer w-full lg:w-auto"
        >
          សាកសួរអ្នកជំនាញ AI
        </button>
      </div>
    </section>

    <div id="loading" class="hidden py-16 text-center">
      <div class="relative w-20 h-20 mx-auto mb-8">
        <div
          class="absolute inset-0 border-4 border-yellow-500/10 rounded-full"
        ></div>
        <div
          class="absolute inset-0 border-4 border-t-yellow-500 rounded-full animate-spin"
        ></div>
      </div>
      <p
        class="text-yellow-500 text-xs font-bold animate-pulse uppercase tracking-[0.4em]"
      >
        កំពុងស្រាវជ្រាវក្រាំងមាស...
      </p>
    </div>

    <div
      id="responseSection"
      class="hidden animate-in slide-in-from-bottom-6 duration-700"
    >
      <div class="magic-card p-10 md:p-14 border-l-[12px] border-yellow-600">
        <div
          class="text-[10px] font-bold text-yellow-600/50 uppercase tracking-[0.3em] mb-8"
        >
          Chronicle Extraction Result
        </div>
        <div id="responseText" class="prose-custom italic"></div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  const socket = io();
  let isWaiting = false;

  // ១. Background Animation (រង្វើល និងយឺត)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    const count = window.innerWidth < 768 ? 30 : 60;
    for (let i = 0; i < count; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 2,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#d4af37' %>";
    ctx.strokeStyle = "rgba(212, 175, 55, 0.05)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 150) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. AI Interaction Logic
  function askAI() {
    if (isWaiting) return;
    const question = document.getElementById("questionInput").value.trim();
    const type = document.getElementById("answerType").value;
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!firebaseUid)
      return Swal.fire({
        text: "សូមចូលគណនីសិនប្អូន!",
        icon: "warning",
        confirmButtonColor: "#d4af37",
      });
    if (!question)
      return Swal.fire({
        text: "តើបងចង់ដឹងអ្វីដែរ?",
        icon: "question",
        confirmButtonColor: "#d4af37",
      });

    toggleState(true);
    socket.emit("ask_culture", { question, type, firebaseUid });
  }

  socket.on("culture_result", (data) => {
    toggleState(false);
    document.getElementById("responseSection").classList.remove("hidden");
    document.getElementById("responseText").innerHTML = marked.parse(
      data.response,
    );
    document
      .getElementById("responseSection")
      .scrollIntoView({ behavior: "smooth" });
  });

  socket.on("error_occured", (msg) => {
    toggleState(false);
    Swal.fire({
      icon: "error",
      title: "Oops!",
      text: msg,
      background: "#0f172a",
      color: "#fff",
    });
  });

  function toggleState(loading) {
    isWaiting = loading;
    const btn = document.getElementById("btnAsk");
    const loader = document.getElementById("loading");
    btn.disabled = loading;
    if (loading) {
      loader.classList.remove("hidden");
      document.getElementById("responseSection").classList.add("hidden");
    } else {
      loader.classList.add("hidden");
    }
  }
</script>
