<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link
  href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;700&display=swap"
  rel="stylesheet"
/>

<style>
  :root {
    --royal-gold: <%= theme || "#d4af37" %>;
    --gold-glow: rgba(212, 175, 55, 0.2);
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(212, 175, 55, 0.15);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.7;
    overflow-x: hidden;
  }

  /* ១. Background បែបថ្លៃថ្នូរ */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.15;
    pointer-events: none;
  }
  .bg-pattern {
    position: fixed;
    inset: 0;
    background-image: url("https://www.transparenttextures.com/patterns/pinstriped-suit.png");
    opacity: 0.03;
    z-index: -15;
    pointer-events: none;
  }

  /* ២. Layout Optimization (PC & Mobile) */
  .sage-container {
    max-width: 1200px; /* ពង្រីកឱ្យពេញ PC */
    width: 95%;
    margin: 20px auto;
    position: relative;
    z-index: 10;
  }

  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 28px;
    border: 1px solid var(--border-light);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
    transition: all 0.3s ease;
  }

  /* --- Chat Box Style --- */
  #chatDisplay {
    max-height: 450px;
    overflow-y: auto;
    margin-bottom: 25px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 10px;
  }
  #chatDisplay::-webkit-scrollbar {
    width: 5px;
  }
  #chatDisplay::-webkit-scrollbar-thumb {
    background: var(--border-light);
    border-radius: 10px;
  }

  .bubble {
    max-width: 85%;
    padding: 18px;
    border-radius: 22px;
    font-size: 1rem;
    animation: fadeInUp 0.5s ease;
    line-height: 1.7;
  }
  .user-bubble {
    align-self: flex-end;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 1px solid var(--border-light);
    border-bottom-right-radius: 4px;
  }
  .sage-bubble {
    align-self: flex-start;
    background: rgba(212, 175, 55, 0.05);
    border-left: 5px solid var(--royal-gold);
    border-bottom-left-radius: 4px;
  }

  .sage-label {
    font-size: 0.7rem;
    font-weight: 900;
    color: var(--royal-gold);
    text-transform: uppercase;
    margin-bottom: 8px;
    letter-spacing: 2px;
  }

  /* --- Input Area --- */
  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 20px !important;
    color: white !important;
    padding: 1rem !important;
    width: 100%;
    outline: none;
    font-size: 1rem;
    transition: 0.3s;
  }

  #imgPreview {
    max-width: 150px;
    border-radius: 12px;
    border: 2px solid var(--royal-gold);
    margin: 10px 0;
    display: none;
  }

  /* --- Button Styles --- */
  .btn-khmer {
    background: linear-gradient(135deg, #b8860b 0%, #ffd700 50%, #b8860b 100%);
    color: #0f172a !important;
    font-weight: 800;
    padding: 12px 30px;
    border-radius: 15px;
    border: none;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
    font-size: 0.9rem;
  }
  .btn-khmer:disabled {
    filter: grayscale(1);
    cursor: not-allowed;
  }

  .shimmer-gold {
    background: linear-gradient(90deg, #ffd700, #fff, #ffd700);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 6s linear infinite;
  }
  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }

  .heritage-badge {
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--border-light);
    color: var(--royal-gold);
    padding: 6px 16px;
    border-radius: 99px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .sage-container {
      margin: 10px auto;
    }
    .bubble {
      max-width: 92%;
      font-size: 0.9rem;
    }
    .shimmer-gold {
      font-size: 2.5rem;
    }
    .btn-khmer {
      width: 100%;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<canvas id="neural-bg"></canvas>
<div class="bg-pattern"></div>

<main class="sage-container">
  <header class="text-center mb-10 animate-in fade-in duration-1000">
    <div class="flex justify-center mb-4">
      <span class="heritage-badge">Ancient Wisdom x AI Intelligence</span>
    </div>
    <h2
      class="text-5xl md:text-7xl font-black shimmer-gold mb-4 uppercase italic leading-none"
    >
      មគ្គុទ្ទេសក៍វប្បធម៌
    </h2>
    <p class="text-slate-400 italic text-sm md:text-base">
      "បើកក្រាំងមាសនៃប្រវត្តិសាស្ត្រខ្មែរ តាមរយៈភ្នែកទិព្វ AI"
    </p>
  </header>

  <div class="magic-card p-6 md:p-10">
    <div id="chatDisplay">
      <div class="bubble sage-bubble">
        <div class="sage-label">Lork Ta Sage</div>
        ចម្រើនពរចៅៗ! ចង់ដឹងអាថ៌កំបាំងបុរាណអីខ្លះ? បើមានរូបភាពប្រាសាទ វត្ថុបុរាណ
        ឬសម្លៀកបំពាក់ បោះមកឱ្យលោកតាជួយមើលក៏បាន!
      </div>
    </div>

    <div id="loading" class="hidden text-center py-6">
      <div
        class="w-10 h-10 border-4 border-yellow-500/20 border-t-yellow-500 rounded-full animate-spin mx-auto mb-4"
      ></div>
      <p
        class="text-yellow-500 text-[10px] font-bold animate-pulse uppercase tracking-widest"
      >
        កំពុងស្រាវជ្រាវក្រាំងមាស...
      </p>
    </div>

    <hr
      style="
        border: 0;
        border-top: 1px solid var(--border-light);
        margin: 25px 0;
      "
    />

    <div class="space-y-4">
      <center><img id="imgPreview" src="" alt="Artifact Preview" /></center>

      <textarea
        id="questionInput"
        class="input-custom h-24 md:h-32 resize-none"
        placeholder="ឧទាហរណ៍៖ តើហនុមានជានរណា? (ប្អូនអាចបោះរូបភាពចូលបាន)"
      ></textarea>

      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex gap-2 w-full md:w-auto">
          <button
            onclick="document.getElementById('fileInput').click()"
            class="btn-khmer !bg-slate-800 !text-white !border !border-yellow-500/30 text-xs"
          >
            📸 រូបភាព
          </button>
          <input
            type="file"
            id="fileInput"
            hidden
            accept="image/*"
            onchange="previewImg(this)"
          />

          <select
            id="answerType"
            class="btn-khmer !bg-slate-900 !text-yellow-500 text-xs"
          >
            <option value="brief">✨ សង្ខេបខ្លឹម</option>
            <option value="detailed">📜 ពន្យល់លម្អិត</option>
          </select>
        </div>

        <button
          onclick="askSage()"
          id="btnAction"
          class="btn-khmer w-full md:w-auto"
        >
          សួរលោកតាឥសី 🔥
        </button>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  let base64Img = null;
  let isWaiting = false;

  // ១. Background Animation
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    const count = window.innerWidth < 768 ? 30 : 60;
    for (let i = 0; i < count; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 2,
      });
    }
  }
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#d4af37' %>";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Image Handling
  function previewImg(input) {
    const file = input.files[0];
    const reader = new FileReader();
    reader.onload = (e) => {
      document.getElementById("imgPreview").src = e.target.result;
      document.getElementById("imgPreview").style.display = "block";
      base64Img = e.target.result.split(",")[1];
    };
    if (file) reader.readAsDataURL(file);
  }

  // ៣. Typewriter Effect
  function typeWriter(element, text) {
    let i = 0;
    element.innerHTML = "";
    function typing() {
      if (i < text.length) {
        element.innerHTML = marked.parse(text.substring(0, i + 1));
        i++;
        setTimeout(typing, 15);
        const display = document.getElementById("chatDisplay");
        display.scrollTop = display.scrollHeight;
      }
    }
    typing();
  }

  // ៤. Logic Interaction
  async function askSage() {
    if (isWaiting) return;
    const input = document.getElementById("questionInput");
    const question = input.value.trim();
    const type = document.getElementById("answerType").value;
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!question && !base64Img) return alert("សួរលោកតាមួយមាត់មកចៅ! 😂");
    if (!firebaseUid) return alert("សូមចូលគណនីសិនប្អូន!");

    // បង្ហាញសារ User
    const chatDisplay = document.getElementById("chatDisplay");
    const userDiv = document.createElement("div");
    userDiv.className = "bubble user-bubble";
    let userContent = question;
    if (base64Img)
      userContent += `<br><img src="data:image/jpeg;base64,${base64Img}" style="max-width:200px; border-radius:10px; margin-top:10px;">`;
    userDiv.innerHTML = userContent;
    chatDisplay.appendChild(userDiv);
    chatDisplay.scrollTop = chatDisplay.scrollHeight;

    // Loading State
    isWaiting = true;
    document.getElementById("loading").classList.remove("hidden");
    document.getElementById("btnAction").disabled = true;

    socket.emit("ask_culture", {
      question,
      image: base64Img,
      type,
      firebaseUid,
    });

    input.value = "";
    document.getElementById("imgPreview").style.display = "none";
  }

  socket.on("culture_result", (data) => {
    isWaiting = false;
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("btnAction").disabled = false;

    const chatDisplay = document.getElementById("chatDisplay");
    const sageDiv = document.createElement("div");
    sageDiv.className = "bubble sage-bubble";
    const textTarget = document.createElement("div");
    sageDiv.innerHTML = `<div class="sage-label">Lork Ta Sage</div>`;
    sageDiv.appendChild(textTarget);
    chatDisplay.appendChild(sageDiv);

    typeWriter(textTarget, data.response);
    base64Img = null;
  });

  socket.on("error_occured", (msg) => {
    // ១. បិទ Loading និងបើកប៊ូតុងឱ្យដើរវិញជាមុនសិន ដើម្បីឱ្យ User អាចចុចម្តងទៀតបាន
    if (document.getElementById("loading")) {
      document.getElementById("loading").classList.add("hidden");
    }

    const btn =
      document.getElementById("btnAction") ||
      document.getElementById("btnSend");
    if (btn) btn.disabled = false;

    // ២. ប្ដូរពី alert(msg) មកប្រើ Premium Popup វិញ
    Swal.fire({
      title: "Neural Limit Reached! 🚀",
      text: msg,
      icon: "warning",
      background: "#0f172a", // ពណ៌ងងឹតស៊ីជាមួយ Theme បង
      color: "#f1f5f9",
      showCancelButton: true,
      confirmButtonColor: "#8b5cf6", // ពណ៌ស្វាយ Premium
      cancelButtonColor: "#475569",
      confirmButtonText: "ទៅ Upgrade ឥឡូវ 🔥",
      cancelButtonText: "ចាំពេលក្រោយ",
      backdrop: `rgba(15, 23, 42, 0.8) blur(8px)`, // បន្ថែម Blur ឱ្យមើលទៅថ្លៃថ្នូរ
      customClass: {
        popup: "rounded-[2.5rem] border border-white/10 shadow-2xl",
        title: "font-black uppercase tracking-widest text-indigo-400",
      },
    }).then((result) => {
      // ៣. បើ User ដាច់ចិត្តចុច Upgrade យើងបាញ់គេទៅទំព័រ Plans ហ្មង!
      if (result.isConfirmed) {
        window.location.href = "/plans";
      }
    });
  });
</script>

<%- include('partials/footer') %>
