<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --primary: <%= theme || "#22d3ee" %>;
    --secondary: #6366f1;
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.1);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* ១. Background Animation (Calm Learning Environment) */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.15;
    pointer-events: none;
  }

  /* --- Full Screen PC Optimization --- */
  .tutor-container {
    max-width: 1200px; /* ពង្រីកឱ្យពេញ PC */
    width: 95%;
    margin: 40px auto;
    position: relative;
    z-index: 10;
  }

  .magic-card {
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 30px;
    border: 1px solid var(--border-light);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    transition: 0.3s ease;
  }

  /* --- Vision Support: Image Preview --- */
  #imgPreview {
    max-width: 250px;
    border-radius: 15px;
    border: 2px solid var(--primary);
    display: none;
    margin: 15px auto;
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.2);
  }

  .mode-btn {
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    border: 1px solid var(--border-light);
    padding: 0.8rem 1.5rem;
    border-radius: 15px;
    font-weight: 700;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .mode-btn.active {
    background: var(--primary);
    color: #0f172a;
    border-color: var(--primary);
    box-shadow: 0 0 15px var(--primary);
  }

  .btn-generate {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: #0f172a;
    font-weight: 800;
    padding: 1rem 2rem;
    border-radius: 20px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .btn-generate:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px -5px rgba(34, 211, 238, 0.4);
  }

  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 2px solid var(--border-light) !important;
    border-radius: 24px !important;
    color: white !important;
    padding: 1.2rem 1.5rem !important;
    font-size: 1.1rem;
    outline: none;
    transition: all 0.3s ease;
  }

  .result-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--primary);
    margin-bottom: 1.5rem;
  }

  /* Markdown Content Styling */
  .markdown-body {
    color: #e2e8f0;
    line-height: 1.8;
  }
  .markdown-body h1,
  .markdown-body h2 {
    color: var(--primary);
    margin-top: 1rem;
  }
  .markdown-body strong {
    color: #fff;
    border-bottom: 1px dashed var(--primary);
  }

  .point-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-light);
    border-radius: 24px;
    padding: 2rem;
    transition: 0.3s;
  }

  .point-card:hover {
    border-color: var(--primary);
    transform: translateY(-5px);
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }

  @keyframes shine {
    to {
      background-position: 200% center;
    }
  }
</style>

<canvas id="neural-bg"></canvas>

<main class="tutor-container">
  <header
    class="text-center mb-16 animate-in fade-in slide-in-from-top-10 duration-700"
  >
    <div
      class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 mb-8"
    >
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest"
        >AI Tutor Intelligence</span
      >
    </div>

    <h1
      class="text-5xl md:text-8xl font-black shimmer-text mb-8 italic uppercase leading-tight"
    >
      គ្រូជំនួយ AI
    </h1>

    <div class="max-w-3xl mx-auto">
      <p
        class="text-xl md:text-2xl font-light text-slate-300 leading-relaxed mb-10"
      >
        "រៀនឱ្យឆ្លាត យល់ឱ្យច្បាស់! បកស្រាយរឿងស្មុគស្មាញឱ្យក្លាយជារឿង
        <span class="text-cyan-400 font-bold">សាមញ្ញបំផុត</span> សម្រាប់បង!"
      </p>
    </div>
  </header>

  <section
    class="magic-card p-8 md:p-12 mb-16 animate-in zoom-in-95 duration-700"
  >
    <div
      class="flex flex-col lg:flex-row justify-between items-center gap-10 mb-12"
    >
      <div class="text-left">
        <h2 class="text-2xl font-bold text-white mb-2">តើបងចង់រៀនអំពីអ្វី?</h2>
        <p class="text-slate-500 text-sm">
          ជ្រើសរើសកម្រិតនៃការបកស្រាយ និងបោះរូបភាពចូលបើមាន
        </p>
      </div>
      <div class="flex flex-wrap gap-4 w-full md:w-auto justify-center">
        <button onclick="setMode('kid', this)" class="mode-btn active">
          👶 បែបក្មេងៗ
        </button>
        <button onclick="setMode('simple', this)" class="mode-btn">
          💡 បែបសាមញ្ញ
        </button>
        <button
          onclick="document.getElementById('fileInput').click()"
          class="mode-btn !bg-slate-700 !text-white"
        >
          📸 បោះរូបភាពលំហាត់
        </button>
        <input
          type="file"
          id="fileInput"
          hidden
          accept="image/*"
          onchange="previewImg(this)"
        />
      </div>
    </div>

    <center><img id="imgPreview" src="" alt="Exercise Preview" /></center>

    <div class="relative group mt-6">
      <input
        type="text"
        id="topicInput"
        class="input-custom w-full placeholder:text-slate-700"
        placeholder="បញ្ចូលប្រធានបទ... (ឧ. ហេតុអ្វីមេឃពណ៌ខៀវ?)"
      />
      <button
        onclick="askTutor()"
        id="btnAction"
        class="lg:absolute right-3 top-3 bottom-3 mt-6 lg:mt-0 w-full lg:w-auto btn-generate"
      >
        បង្កើតចំណេះដឹង 🔥
      </button>
    </div>
  </section>

  <div id="loading" class="hidden flex flex-col items-center py-20">
    <div class="relative w-20 h-20 mb-8">
      <div class="absolute inset-0 border-4 border-white/5 rounded-full"></div>
      <div
        class="absolute inset-0 border-4 border-t-cyan-500 rounded-full animate-spin"
      ></div>
    </div>
    <p
      class="text-cyan-500 font-bold tracking-[0.3em] animate-pulse uppercase text-xs"
    >
      កំពុងទាញយកទិន្នន័យចំណេះដឹង...
    </p>
  </div>

  <div
    id="answerArea"
    class="hidden space-y-12 animate-in slide-in-from-bottom-10 duration-700"
  >
    <div class="magic-card p-10 md:p-16 border-l-[12px] border-cyan-400">
      <div class="flex justify-between items-start mb-6">
        <h3 id="resTitle" class="result-title uppercase italic"></h3>
        <button
          onclick="copyLesson()"
          class="text-[10px] text-slate-400 hover:text-white uppercase tracking-widest"
        >
          Copy Lesson 📋
        </button>
      </div>
      <div
        id="resDesc"
        class="markdown-body text-xl md:text-2xl font-light text-slate-200 leading-relaxed italic"
      ></div>
    </div>

    <div
      id="pointsContainer"
      class="grid grid-cols-1 md:grid-cols-2 gap-8"
    ></div>

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-10 pt-10 border-t border-white/10"
    >
      <div class="lg:col-span-2 space-y-8">
        <h4
          class="text-sm font-bold text-yellow-500 uppercase tracking-widest flex items-center gap-4"
        >
          <span class="h-px flex-1 bg-yellow-500/20"></span> ឧទាហរណ៍ជាក់ស្ដែង
        </h4>
        <ul id="resExamples" class="space-y-6"></ul>
      </div>
      <div
        class="magic-card p-10 bg-cyan-400/5 text-center flex items-center justify-center border-dashed border-cyan-500/20"
      >
        <div>
          <span class="text-6xl mb-6 block">💡</span>
          <p
            id="resFunFact"
            class="text-lg text-cyan-200 italic font-medium leading-relaxed"
          ></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  let currentMode = "kid";
  let base64Img = null;

  // ១. Background Animation
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };

  window.addEventListener("mousemove", (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 50; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        size: Math.random() * 1.5,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "<%= theme || '#22d3ee' %>";
    ctx.strokeStyle = "rgba(34, 211, 238, 0.05)";
    dots.forEach((d) => {
      d.x += d.vx;
      d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 180) {
        ctx.beginPath();
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(mouse.x, mouse.y);
        ctx.stroke();
      }
      ctx.beginPath();
      ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
      ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init();
  draw();
  window.addEventListener("resize", init);

  // ២. Vision Support: Image Handling
  function previewImg(input) {
    const file = input.files[0];
    const reader = new FileReader();
    reader.onload = (e) => {
      document.getElementById("imgPreview").src = e.target.result;
      document.getElementById("imgPreview").style.display = "block";
      base64Img = e.target.result.split(",")[1];
    };
    if (file) reader.readAsDataURL(file);
  }

  // ៣. Typewriter Effect with Markdown Rendering
  function typeWriter(id, text) {
    let i = 0;
    const el = document.getElementById(id);
    el.innerHTML = "";
    function type() {
      if (i < text.length) {
        // Render Markdown based on substring for real-time effect
        el.innerHTML = marked.parse(text.substring(0, i + 1));
        i++;
        setTimeout(type, 12);
        const area = document.getElementById("answerArea");
        // Optional: Auto-scroll while typing
      }
    }
    type();
  }

  function setMode(mode, btn) {
    currentMode = mode;
    document
      .querySelectorAll(".mode-btn")
      .forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
  }

  async function askTutor() {
    const topic = document.getElementById("topicInput").value.trim();
    const firebaseUid = "<%= user ? user.firebaseUid : '' %>";

    if (!topic && !base64Img)
      return Swal.fire({ text: "ប្រាប់គ្រូថាចង់រៀនអីដែរចៅ? 😂", icon: "info" });
    if (!firebaseUid)
      return Swal.fire({ text: "សូមចូលគណនីសិនបង!", icon: "warning" });

    document.getElementById("loading").classList.remove("hidden");
    document.getElementById("answerArea").classList.add("hidden");
    document.getElementById("btnAction").disabled = true;

    // Send both topic and image to backend
    socket.emit("ask_tutor", {
      topic,
      image: base64Img,
      mode: currentMode,
      firebaseUid,
    });
  }

  socket.on("tutor_result", (data) => {
    document.getElementById("loading").classList.add("hidden");
    document.getElementById("answerArea").classList.remove("hidden");
    document.getElementById("btnAction").disabled = false;
    document.getElementById("resTitle").innerText = data.title;

    // Start Typing Effect for the Explanation
    typeWriter("resDesc", data.explanation);

    // Render Key Points
    document.getElementById("pointsContainer").innerHTML = data.key_points
      .map(
        (p) => `
      <div class="point-card">
        <div class="text-cyan-400 font-black text-xl mb-4 underline decoration-cyan-500/20">${p.label}</div>
        <p class="text-lg text-slate-400 font-light leading-relaxed">${p.desc}</p>
      </div>
    `,
      )
      .join("");

    // Render Examples
    document.getElementById("resExamples").innerHTML = data.examples
      .map(
        (ex) => `
      <li class="flex items-start gap-4 text-slate-200 text-lg">
        <span class="text-cyan-400 mt-1">●</span>
        <span class="font-light">${ex}</span>
      </li>
    `,
      )
      .join("");

    document.getElementById("resFunFact").innerText =
      "ដឹងអត់ថា? " + data.fun_fact;
    document
      .getElementById("answerArea")
      .scrollIntoView({ behavior: "smooth" });

    // Reset Image after processing
    base64Img = null;
    document.getElementById("imgPreview").style.display = "none";
  });

  function copyLesson() {
    const title = document.getElementById("resTitle").innerText;
    const desc = document.getElementById("resDesc").innerText;
    navigator.clipboard.writeText(`${title}\n\n${desc}`);
    Swal.fire({
      text: "មេរៀនត្រូវបានចម្លងទុក! 📋",
      icon: "success",
      timer: 1500,
      showConfirmButton: false,
    });
  }

  socket.on("error_occured", (msg) => {
    // ១. បិទ Loading និងបើកប៊ូតុងឱ្យដើរវិញជាមុនសិន ដើម្បីឱ្យ User អាចចុចម្តងទៀតបាន
    if (document.getElementById("loading")) {
      document.getElementById("loading").classList.add("hidden");
    }

    const btn =
      document.getElementById("btnAction") ||
      document.getElementById("btnSend");
    if (btn) btn.disabled = false;

    // ២. ប្ដូរពី alert(msg) មកប្រើ Premium Popup វិញ
    Swal.fire({
      title: "Neural Limit Reached! 🚀",
      text: msg,
      icon: "warning",
      background: "#0f172a", // ពណ៌ងងឹតស៊ីជាមួយ Theme បង
      color: "#f1f5f9",
      showCancelButton: true,
      confirmButtonColor: "#8b5cf6", // ពណ៌ស្វាយ Premium
      cancelButtonColor: "#475569",
      confirmButtonText: "ទៅ Upgrade ឥឡូវ 🔥",
      cancelButtonText: "ចាំពេលក្រោយ",
      backdrop: `rgba(15, 23, 42, 0.8) blur(8px)`, // បន្ថែម Blur ឱ្យមើលទៅថ្លៃថ្នូរ
      customClass: {
        popup: "rounded-[2.5rem] border border-white/10 shadow-2xl",
        title: "font-black uppercase tracking-widest text-indigo-400",
      },
    }).then((result) => {
      // ៣. បើ User ដាច់ចិត្តចុច Upgrade យើងបាញ់គេទៅទំព័រ Plans ហ្មង!
      if (result.isConfirmed) {
        window.location.href = "/plans";
      }
    });
  });
</script>
