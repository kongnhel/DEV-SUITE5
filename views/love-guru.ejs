<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --dark-bg: #0f172a;
    --rage-red: #ef4444;
    --flame-orange: #f59e0b;
    --glass-bg: rgba(30, 41, 59, 0.7);
    --border-color: rgba(255, 255, 255, 0.1);
    --pink-sweet: #ec4899;
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--dark-bg);
    color: #f1f5f9;
    overflow-x: hidden;
  }

  /* --- Mood Animation Overlay --- */
  #moodOverlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    transition: 2s ease;
  }
  /* បទសេដ៖ ឱ្យអេក្រង់ងងឹតខៀវបន្តិច (Rainy Vibe) */
  .mood-sad {
    background: radial-gradient(
      circle,
      rgba(15, 23, 42, 0.4) 0%,
      rgba(0, 0, 50, 0.7) 100%
    );
    opacity: 1 !important;
  }
  /* បទផ្អែម៖ ឱ្យអេក្រង់ផ្កាឈូកស្រាល (Sweet Vibe) */
  .mood-sweet {
    background: radial-gradient(
      circle,
      rgba(236, 72, 153, 0.2) 0%,
      rgba(15, 23, 42, 0.6) 100%
    );
    opacity: 1 !important;
  }

  #fireCanvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 99;
  }

  .rage-container {
    max-width: 1200px; /* ពង្រីកឱ្យពេញអេក្រង់ PC */
    width: 95%;
    margin: 40px auto;
    padding: 20px;
    position: relative;
    z-index: 10;
  }

  /* --- Personality Selector --- */
  .personality-selector {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 25px;
  }
  .persona-btn {
    padding: 10px 25px;
    border-radius: 30px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    cursor: pointer;
    transition: 0.3s;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .persona-btn.active {
    border-color: var(--flame-orange);
    color: white;
    background: var(--flame-orange);
    box-shadow: 0 0 20px rgba(245, 158, 11, 0.4);
  }
  .persona-btn.active.sweet {
    background: var(--pink-sweet);
    border-color: var(--pink-sweet);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.4);
  }

  .love-card {
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 40px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  #chatHistory {
    max-height: 550px;
    overflow-y: auto;
    margin-bottom: 25px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-right: 10px;
  }
  #chatHistory::-webkit-scrollbar {
    width: 5px;
  }
  #chatHistory::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 10px;
  }

  .chat-bubble {
    max-width: 75%;
    padding: 20px;
    border-radius: 20px;
    font-size: 1rem;
    line-height: 1.7;
    animation: fadeInUp 0.4s ease;
  }
  .user-bubble {
    align-self: flex-end;
    background: linear-gradient(135deg, #334155, #1e293b);
    border: 1px solid var(--border-color);
    border-bottom-right-radius: 4px;
  }
  .ai-bubble {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.05);
    border-left: 5px solid var(--flame-orange);
    border-bottom-left-radius: 4px;
  }
  .ai-bubble.sweet-mode {
    border-left-color: var(--pink-sweet);
  }

  .ai-label {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--flame-orange);
    margin-bottom: 10px;
    text-transform: uppercase;
  }
  .sweet-mode .ai-label {
    color: var(--pink-sweet);
  }

  .song-lead-in {
    font-style: italic;
    color: #94a3b8;
    margin-top: 15px;
    font-size: 0.9rem;
    display: block;
    border-top: 1px solid var(--border-color);
    padding-top: 10px;
  }

  .song-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 10px 20px;
    border-radius: 30px;
    background: var(--pink-sweet);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: 0.3s;
  }
  .song-btn.is-playing {
    background: var(--flame-orange);
    animation: pulse 1.5s infinite;
  }

  /* --- Original Effects --- */
  .upload-zone {
    border: 2px dashed var(--border-color);
    border-radius: 18px;
    padding: 20px;
    text-align: center;
    margin-bottom: 20px;
    cursor: pointer;
    background: rgba(15, 23, 42, 0.5);
  }
  #previewImage {
    max-width: 200px;
    border-radius: 12px;
    margin-top: 15px;
    display: none;
    border: 2px solid var(--rage-red);
  }
  #ventArea {
    width: 100%;
    height: 120px;
    background: rgba(15, 23, 42, 0.8);
    border: 2px solid var(--border-color);
    border-radius: 18px;
    padding: 20px;
    color: #ff9f9f;
    font-size: 1.1rem;
    resize: none;
    outline: none;
  }
  .is-burning {
    animation: burn-away 1.5s forwards;
    pointer-events: none;
    filter: blur(8px) brightness(2);
    opacity: 0;
  }
  @keyframes burn-away {
    0% {
      transform: scale(1);
      opacity: 1;
      color: #ff4d4d;
    }
    100% {
      transform: scale(0.9) translateY(-20px);
      opacity: 0;
    }
  }
  .btn-burn {
    background: linear-gradient(45deg, #ce1212, #ff5f00);
    color: white;
    border: none;
    padding: 15px 40px;
    border-radius: 14px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .spinner {
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  #loadingSkeleton {
    display: none;
    margin-top: 15px;
  }
  .skeleton-line {
    height: 15px;
    background: rgba(255, 255, 255, 0.05);
    margin-bottom: 8px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .skeleton-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.05),
      transparent
    );
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div id="moodOverlay"></div>

<canvas id="fireCanvas"></canvas>

<div class="rage-container">
  <div class="personality-selector">
    <button
      onclick="setPersonality('rage')"
      id="rageBtn"
      class="persona-btn active"
    >
      🔥 Version កាច (Rage Mode:ដៀលjmហើយហាស់)
    </button>
    <button
      onclick="setPersonality('sweet')"
      id="sweetBtn"
      class="persona-btn sweet"
    >
      💖  Version ស្លូត (Sweet Mode:បែបផ្អែមដូចទឹកឃ្មុំ)
    </button>
  </div>

  <div class="love-card">
    <h2 class="vent-title">LOVE HEALER: RAGE MODE</h2>

    <div id="chatHistory">
      <div class="ai-bubble">
        <div class="ai-label">Senior Dev Healer</div>
        សួស្តីអាហ្វ្រេន! ថ្ងៃនេះ មិចហើយជីវិតស្នេហា? សមនឹងឱ្យបងជេរឱ្យភ្លឺភ្នែកតែម្ដង!
        បើមាន Screenshot ឆាតគេ ឬរូបថតគេ បោះមក បងជួយវិភាគមើល បើមិនកើតដុតឱ្យខ្ទេច!
      </div>
    </div>

    <div id="loadingSkeleton">
      <div class="ai-label" id="loaderLabel">
        Senior Dev កំពុងពិនិត្យ...
      </div>
      <div class="skeleton-line" style="width: 100%"></div>
      <div class="skeleton-line" style="width: 70%"></div>
    </div>

    <hr
      style="
        border: 0;
        border-top: 1px solid var(--border-color);
        margin: 30px 0;
      "
    />

    <div
      class="upload-zone"
      onclick="document.getElementById('imageInput').click()"
    >
      <span class="text-slate-400">📸 ចុចដើម្បីបោះរូបភាព (Chat ឬ Ex)</span>
      <input
        type="file"
        id="imageInput"
        hidden
        accept="image/*"
        onchange="previewFile()"
      />
      <center><img id="previewImage" src="" alt="Ex Preview" /></center>
    </div>

    <textarea
      id="ventArea"
      placeholder="សរសេររៀបរាប់ពីទង្វើថោកទាបរបស់វា..."
    ></textarea>

    <div class="flex justify-center mt-8">
      <button onclick="executeBurn()" id="burnBtn" class="btn-burn">
        <div id="btnSpinner" class="spinner"></div>
        <span id="btnText">🔥 បញ្ជូនទៅដុត</span>
      </button>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const canvas = document.getElementById("fireCanvas");
  const ctx = canvas.getContext("2d");
  let particles = [];
  let base64Image = null;
  let currentAudio = null;
  let selectedPersonality = "rage";

  // --- Dual Personality Toggle ---
  function setPersonality(type) {
    selectedPersonality = type;
    document
      .getElementById("rageBtn")
      .classList.toggle("active", type === "rage");
    document
      .getElementById("sweetBtn")
      .classList.toggle("active", type === "sweet");
    document.getElementById("loaderLabel").innerText =
      type === "rage"
        ? "Senior Dev កំពុងពិនិត្យមុខវា..."
        : "Angel Healer កំពុងយំជាមួយប្អូន...";
  }

  // --- Typing Effect Function ---
  function typeWriter(element, text, speed = 20) {
    let i = 0;
    element.innerHTML = "";
    function typing() {
      if (i < text.length) {
        element.innerHTML = marked.parse(text.substring(0, i + 1));
        i++;
        setTimeout(typing, speed);
        document.getElementById("chatHistory").scrollTop =
          document.getElementById("chatHistory").scrollHeight;
      }
    }
    typing();
  }

  function previewFile() {
    const preview = document.getElementById("previewImage");
    const file = document.getElementById("imageInput").files[0];
    const reader = new FileReader();
    reader.onloadend = () => {
      preview.src = reader.result;
      preview.style.display = "block";
      base64Image = reader.result.split(",")[1];
    };
    if (file) reader.readAsDataURL(file);
  }

  // --- Mood Animation Control ---
  function toggleSong(filename, btn) {
    const overlay = document.getElementById("moodOverlay");

    // កំណត់ Mood តាមឈ្មោះ File (បងអាចថែម Mood តាមចិត្ត)
    if (filename.includes("sad") || filename.includes("tok_prik")) {
      overlay.className = "mood-sad";
    } else {
      overlay.className = "mood-sweet";
    }

    if (
      currentAudio &&
      !currentAudio.paused &&
      currentAudio.src.includes(filename)
    ) {
      currentAudio.pause();
      btn.classList.remove("is-playing");
      overlay.className = "";
      return;
    }

    if (currentAudio) currentAudio.pause();
    currentAudio = new Audio(`/songs/${filename}`);
    currentAudio.play();
    btn.classList.add("is-playing");

    currentAudio.onended = () => {
      btn.classList.remove("is-playing");
      overlay.className = "";
    };
  }

  // --- Particle System ---
  class Particle {
    constructor(x, y) {
      this.x = x;
      this.y = y;
      this.size = Math.random() * 5 + 2;
      this.speedY = Math.random() * -3 - 1;
      this.color = `hsl(${Math.random() * 30 + 15}, 100%, 50%)`;
      this.opacity = 1;
    }
    update() {
      this.y += this.speedY;
      this.opacity -= 0.02;
    }
    draw() {
      ctx.globalAlpha = this.opacity;
      ctx.fillStyle = this.color;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
    }
  }
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach((p, i) => {
      p.update();
      p.draw();
      if (p.opacity <= 0) particles.splice(i, 1);
    });
    requestAnimationFrame(animate);
  }
  window.addEventListener("resize", () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  });
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  animate();

  async function executeBurn() {
    const ventArea = document.getElementById("ventArea");
    const chatHistory = document.getElementById("chatHistory");
    const burnBtn = document.getElementById("burnBtn");
    const message = ventArea.value.trim();

    if (!message && !base64Image) {
      alert("ជេរតិចមកបង! 😂");
      return;
    }

    const fireSound = new Audio("/audio/fire-burn.mp3");
    fireSound.volume = 0.5;
    fireSound.play().catch(() => {});

    const rect = ventArea.getBoundingClientRect();
    for (let i = 0; i < 150; i++) {
      setTimeout(() => {
        particles.push(
          new Particle(
            rect.left + Math.random() * rect.width,
            rect.top + Math.random() * rect.height,
          ),
        );
      }, i * 5);
    }

    const userDiv = document.createElement("div");
    userDiv.className = "chat-bubble user-bubble";
    let userContent = message;
    if (base64Image) {
      userContent += `<br><img src="data:image/jpeg;base64,${base64Image}" class="chat-img-preview" style="max-width:300px">`;
    }
    userDiv.innerHTML = userContent;
    chatHistory.appendChild(userDiv);
    chatHistory.scrollTop = chatHistory.scrollHeight;

    burnBtn.disabled = true;
    document.getElementById("btnSpinner").style.display = "block";
    document.getElementById("loadingSkeleton").style.display = "block";
    ventArea.classList.add("is-burning");

    // បញ្ជូនទាំង Message និង Personality
    socket.emit("vent_out", {
      message: message,
      image: base64Image,
      personality: selectedPersonality,
      firebaseUid: "<%= user ? user.firebaseUid : '' %>",
    });

    ventArea.value = "";
    document.getElementById("previewImage").style.display = "none";
  }

  socket.on("rage_result", (data) => {
    const chatHistory = document.getElementById("chatHistory");
    document.getElementById("loadingSkeleton").style.display = "none";
    document.getElementById("burnBtn").disabled = false;
    document.getElementById("btnSpinner").style.display = "none";
    document.getElementById("ventArea").classList.remove("is-burning");

    let responseText = data.response;
    let songTag = responseText.match(/\[SONG: (.*?)\]/);
    let cleanText = responseText.replace(/\[SONG: .*?\]/g, "").trim();

    const aiDiv = document.createElement("div");
    aiDiv.className = `chat-bubble ai-bubble ${selectedPersonality === "sweet" ? "sweet-mode" : ""}`;

    const textContainer = document.createElement("div");
    aiDiv.innerHTML = `<div class="ai-label">${selectedPersonality === "rage" ? "Senior Dev Healer" : "Sweet Angel Healer"}</div>`;
    aiDiv.appendChild(textContainer);

    if (songTag && songTag[1]) {
      const fileName = songTag[1];
      const leadIn = document.createElement("span");
      leadIn.className = "song-lead-in";
      leadIn.innerText = "មើលតាមស្ថានភាពប្អូនសមនិងបងនេះណាស់ រឺក៏ចាំបងជូនមួយបទ";

      const songBtn = document.createElement("button");
      songBtn.className = "song-btn";
      songBtn.innerHTML = `🎵 ស្ដាប់ចម្រៀង៖ ${fileName.replace(".mp3", "").replace(/_/g, " ")}`;
      songBtn.onclick = () => toggleSong(fileName, songBtn);

      aiDiv.appendChild(leadIn);
      aiDiv.appendChild(songBtn);
    }

    chatHistory.appendChild(aiDiv);
    typeWriter(textContainer, cleanText);
    base64Image = null;
  });

  socket.on("error_occured", (msg) => {
    alert(msg);
    document.getElementById("loadingSkeleton").style.display = "none";
    document.getElementById("burnBtn").disabled = false;
  });
</script>

<%- include('partials/footer') %>
