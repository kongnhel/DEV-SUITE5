<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;700&display=swap" rel="stylesheet" />

<style>
  :root {
    /* កំណត់ពណ៌ទៅតាម Plan របស់បង */
    --plan-color: <%= user.plan === 'plus' ? '#10b981' : (user.plan === 'pro' ? '#8b5cf6' : '#f97316') %>;
    --primary: var(--plan-color);
    --primary-dark: #c2410c;
    --primary-glow: rgba(249, 115, 22, 0.4);
    --bg-dark: #0f172a;
    --card-glass: rgba(30, 41, 59, 0.6);
    --border-glass: rgba(255, 255, 255, 0.1);
  }

  body { font-family: "Kantumruy Pro", sans-serif; background-color: var(--bg-dark); color: #f8fafc; overflow-x: hidden; }

  #neural-bg { position: fixed; inset: 0; z-index: -1; opacity: 0.3; }

  .fade-in-up { animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  .glass-card { background: var(--card-glass); backdrop-filter: blur(20px); border: 1px solid var(--border-glass); border-radius: 24px; position: relative; overflow: hidden; }

  /* 🚀 Avatar Wrapper ជំនាន់ថ្មី (មាន Aura តាម Plan) */
  .avatar-wrapper {
    position: relative;
    width: 160px;
    height: 160px;
    margin: 0 auto;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, var(--primary), #6366f1);
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 0 20px <%= user.plan !== 'standard' ? 'var(--primary)' : 'transparent' %>66;
  }
  .avatar-wrapper:hover { transform: scale(1.05); box-shadow: 0 0 40px var(--primary); }

  .avatar-img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; border: 4px solid var(--bg-dark); background: #1e293b; }

  /* Badge លើរូបភាព */
  .plan-badge-icon {
    position: absolute;
    bottom: 5px;
    right: 5px;
    width: 35px;
    height: 35px;
    background: var(--primary);
    border: 4px solid var(--bg-dark);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    z-index: 10;
  }

  .modern-input { width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-glass); padding: 1rem; border-radius: 12px; color: white; outline: none; transition: 0.3s; }
  .modern-input:focus { border-color: var(--primary); background: rgba(15, 23, 42, 0.9); }

  .input-label { position: absolute; left: 1rem; top: -0.6rem; background: var(--bg-dark); padding: 0 0.5rem; font-size: 0.75rem; color: var(--primary); font-weight: 700; border-radius: 4px; }

  .btn-primary-glow { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; border: none; padding: 1rem; width: 100%; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; }
  .btn-primary-glow:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -5px var(--primary); }

  .shimmer { background: linear-gradient(90deg, #fff, var(--primary), #fff); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: shine 5s linear infinite; }
  @keyframes shine { to { background-position: 200% center; } }
</style>

<canvas id="neural-bg"></canvas>

<main class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-lg fade-in-up">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/50 border border-white/10 mb-4 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full <%= user.plan !== 'standard' ? 'bg-emerald-400 animate-pulse' : 'bg-orange-500' %>"></span>
        <span class="text-[10px] font-black uppercase tracking-widest text-slate-300">
          <%= user.plan.toUpperCase() %> MEMBER STATUS
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-black uppercase shimmer mb-2">កែប្រែព័ត៌មាន</h1>
      <p class="text-slate-400 text-sm font-light italic">"ធ្វើឱ្យ Profile បងកាន់តែឡូយជាងមុន"</p>
    </div>

    <div class="glass-card p-8">
      <form id="profileForm" enctype="multipart/form-data">
        <div class="text-center mb-10">
          <div class="avatar-wrapper" onclick="document.getElementById('photoFile').click()">
            <img id="avatarPreview" class="avatar-img" src="<%= user.photoURL && user.photoURL !== '' ? user.photoURL : 'https://api.dicebear.com/7.x/bottts/svg?seed=' + user.displayName %>" alt="Profile" />
            
            <% if (user.plan !== 'standard') { %>
              <div class="plan-badge-icon">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              </div>
            <% } %>

            <input type="file" id="photoFile" name="photo" accept="image/*" class="hidden" onchange="previewLocalFile(this)" />
            <div class="absolute inset-0 rounded-full bg-black/40 opacity-0 hover:opacity-100 flex items-center justify-center transition-opacity text-[10px] font-bold uppercase tracking-wider text-white">ប្តូររូប</div>
          </div>
          <p class="text-[10px] font-black text-slate-500 mt-4 tracking-widest uppercase">
            Current Tier: <span style="color: var(--primary)"><%= user.plan %></span>
          </p>
        </div>

        <div class="space-y-6">
          <div class="floating-input-group relative">
            <span class="input-label">DISPLAY NAME</span>
            <input type="text" id="displayName" name="displayName" value="<%= user.displayName %>" class="modern-input" placeholder="ឈ្មោះហៅក្រៅ..." required />
          </div>

          <button type="submit" id="submitBtn" class="btn-primary-glow group">
            <span class="relative z-10 flex items-center justify-center gap-2">
              <span>រក្សាទុកការផ្លាស់ប្តូរ</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
            </span>
          </button>
        </div>
      </form>

      <div class="mt-10 pt-6 border-t border-white/5 space-y-3">
        <% if (user.plan !== 'standard') { %>
          <button onclick="confirmCancel()" class="w-full py-3 border border-white/10 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-400 hover:bg-white/5 transition-all">
            បោះបង់គម្រោង (Cancel Subscription)
          </button>
        <% } %>
        <button onclick="confirmDelete()" class="w-full py-3 border border-red-500/20 rounded-xl text-[10px] font-black uppercase tracking-widest text-red-500 hover:bg-red-500/5 transition-all">
          លុបគណនីចោល (Delete Account)
        </button>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  /* --- ១. Background Animation Logic --- */
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let width, height, dots = [];
  function initDots() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    dots = Array.from({ length: 40 }, () => ({ x: Math.random() * width, y: Math.random() * height, vx: (Math.random() - 0.5) * 0.4, vy: (Math.random() - 0.5) * 0.4, size: Math.random() * 1.5 }));
  }
  function animate() {
    ctx.clearRect(0, 0, width, height);
    ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--primary');
    dots.forEach(dot => {
      dot.x += dot.vx; dot.y += dot.vy;
      if (dot.x < 0 || dot.x > width) dot.vx *= -1;
      if (dot.y < 0 || dot.y > height) dot.vy *= -1;
      ctx.beginPath(); ctx.arc(dot.x, dot.y, dot.size, 0, Math.PI * 2); ctx.fill();
    });
    requestAnimationFrame(animate);
  }
  initDots(); animate(); window.addEventListener("resize", initDots);

  function previewLocalFile(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = e => document.getElementById("avatarPreview").src = e.target.result;
      reader.readAsDataURL(input.files[0]);
    }
  }

  /* --- ២. Cancel Subscription Logic --- */
  async function confirmCancel() {
    const result = await Swal.fire({
        title: 'តើបងដាច់ចិត្តមែនទេ? 😭',
        text: "បងនឹងបាត់បង់អំណាច Unlimited និងល្បឿន Neural លឿនដូចហោះណា!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#475569',
        cancelButtonColor: '#8b5cf6',
        confirmButtonText: 'បាទ! បោះបង់',
        cancelButtonText: 'ទេ! ប្រើបន្ត',
        background: '#1e293b', color: '#fff'
    });
    if (result.isConfirmed) {
        const res = await fetch("/api/payment/cancel", { 
            method: "POST", 
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ firebaseUid: "<%= user.firebaseUid %>" })
        });
        const data = await res.json();
        if (data.success) Swal.fire('ជោគជ័យ', data.message, 'success').then(() => window.location.reload());
    }
  }

  /* --- ៣. Profile Update Logic --- */
  document.getElementById("profileForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("submitBtn");
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="animate-spin mr-2">⏳</span> Processing...`;

    try {
      const res = await fetch("/user/update-profile", { method: "POST", body: new FormData(e.target) });
      const result = await res.json();
      if (result.status === "success") {
        Swal.fire({ icon: "success", title: "ជោគជ័យ!", text: "ទិន្នន័យត្រូវបានអាប់ដេត!", background: "#1e293b", color: "#fff" });
      }
    } catch (err) {
      Swal.fire("Error", "មានបញ្ហាបច្ចេកទេសបង!", "error");
    } finally {
      btn.disabled = false; btn.innerHTML = original;
    }
  });

  function confirmDelete() {
    Swal.fire({ title: "គិតច្បាស់នៅ?", text: "ទិន្នន័យនឹងត្រូវលុបចោលរហូត!", icon: "warning", background: "#1e293b", color: "#fff", showCancelButton: true, confirmButtonColor: "#ef4444", confirmButtonText: "លុបចោល!" })
    .then(async (result) => {
      if (result.isConfirmed) {
        await fetch("/user/delete-account", { method: "POST" });
        window.location.href = "/login";
      }
    });
  }
</script>