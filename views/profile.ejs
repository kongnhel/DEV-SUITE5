<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<style>
  :root {
    --primary: #f97316; /* ពណ៌ទឹកក្រូចបែបទំនើប */
    --primary-glow: rgba(249, 115, 22, 0.2);
    --bg-dark: #0f172a;
    --card-bg: rgba(30, 41, 59, 0.7);
    --border-light: rgba(255, 255, 255, 0.08);
  }

  body {
    font-family: "Kantumruy Pro", sans-serif;
    background-color: var(--bg-dark);
    color: #f1f5f9;
    margin: 0;
  }

  /* ១. Background បែបអ័ព្ទក្នុងលំហ (ស្ងប់ស្ងាត់) */
  #neural-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -20;
    opacity: 0.15;
    pointer-events: none;
  }

  /* ២. Profile Card - បែបកញ្ចក់ថ្លា */
  .profile-card {
    background: var(--card-bg);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 28px;
    border: 1px solid var(--border-light);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  /* ៣. Avatar Section */
  .avatar-container {
    position: relative;
    width: 150px;
    height: 150px;
    margin: 0 auto;
    padding: 6px;
    background: linear-gradient(135deg, var(--primary), #6366f1);
    border-radius: 40px;
    box-shadow: 0 10px 25px -5px var(--primary-glow);
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    background: #1e293b;
    border-radius: 35px;
    overflow: hidden;
  }

  #avatarPreview {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ៤. Form Inputs */
  .input-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #94a3b8;
    margin-bottom: 8px;
    margin-left: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .input-custom {
    background: rgba(15, 23, 42, 0.8) !important;
    border: 1px solid var(--border-light) !important;
    border-radius: 16px !important;
    color: white !important;
    padding: 1rem 1.25rem !important;
    width: 100%;
    outline: none;
    transition: all 0.3s ease;
  }

  .input-custom:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 4px var(--primary-glow) !important;
  }

  /* ៥. Buttons */
  .btn-submit {
    background: linear-gradient(135deg, var(--primary), #ea580c);
    color: white;
    font-weight: 700;
    padding: 1.1rem;
    border-radius: 18px;
    width: 100%;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 10px 15px -3px rgba(249, 115, 22, 0.3);
  }

  .btn-submit:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(249, 115, 22, 0.4);
  }

  .btn-delete {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.8rem;
    border-radius: 14px;
    width: 100%;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    transition: all 0.2s;
  }

  .btn-delete:hover {
    background: #ef4444;
    color: white;
  }

  .shimmer-text {
    background: linear-gradient(90deg, #fff, var(--primary), #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }
  @keyframes shine { to { background-position: 200% center; } }
</style>

<canvas id="neural-bg"></canvas>

<main class="max-w-4xl mx-auto px-6 py-12 relative">
  <header class="text-center mb-12 animate-in fade-in duration-700">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6">
      <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
      <span class="text-orange-500 text-[10px] font-bold uppercase tracking-widest">Profile Configuration</span>
    </div>
    <h2 class="text-4xl md:text-6xl font-black shimmer-text uppercase mb-4">ការកំណត់ Profile</h2>
    <p class="text-slate-400 text-lg font-light italic max-w-2xl mx-auto">
      "អាប់ដេតព័ត៌មានផ្ទាល់ខ្លួន ដើម្បីឱ្យ AI កាន់តែយល់ចិត្តប្អូន"
    </p>
  </header>

  <div class="max-w-xl mx-auto">
    <div class="profile-card p-8 md:p-10">
      
      <div class="text-center mb-10">
        <div class="avatar-container mb-4">
          <div class="avatar-inner">
            <img id="avatarPreview" 
                 src="<%= user.photoURL && user.photoURL !== '' ? user.photoURL : 'https://api.dicebear.com/7.x/bottts/svg?seed=' + user.displayName %>" 
                 alt="Profile">
          </div>
        </div>
        <p class="text-[10px] text-slate-500 font-bold uppercase tracking-[0.2em]">Neural Identity Processor</p>
      </div>

      <form id="profileForm" class="space-y-8">
        <div class="input-group">
          <label>ឈ្មោះហៅក្រៅរបស់ប្អូន (Display Name)</label>
          <input type="text" id="displayName" value="<%= user.displayName %>" 
                 class="input-custom" placeholder="បញ្ចូលឈ្មោះរបស់អ្នក..." required />
        </div>

        <div class="input-group">
          <label>តំណភ្ជាប់រូបភាព (Photo URL)</label>
          <input type="text" id="photoURL" value="<%= user.photoURL %>" 
                 oninput="updatePreview(this.value)" class="input-custom" 
                 placeholder="បិទភ្ជាប់ Link រូបភាពពី Facebook ឬ Google..." />
        </div>

        <button type="submit" id="submitBtn" class="btn-submit">
          រក្សាទុកការផ្លាស់ប្តូរ
        </button>
      </form>

      <div class="mt-12 pt-8 border-t border-white/5">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xl">⚠️</span>
          <div>
            <h4 class="text-xs font-bold text-red-500 uppercase">តំបន់គ្រោះថ្នាក់ (Danger Zone)</h4>
            <p class="text-[10px] text-slate-500">លុបគណនី និងរាល់ទិន្នន័យរបស់អ្នកចោលទាំងស្រុង</p>
          </div>
        </div>
        <button onclick="confirmDelete()" class="btn-delete">
          លុបគណនីនេះចោល
        </button>
      </div>

      <div class="text-center mt-8">
        <a href="/dashboard" class="text-xs text-slate-500 hover:text-orange-400 transition-colors italic">
          ← ត្រលប់ទៅកាន់ Dashboard វិញ
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

<script>
  // ១. Background Animation (រង្វើល និងយឺត បែបផ្សែងអ័ព្ទ)
  const canvas = document.getElementById("neural-bg");
  const ctx = canvas.getContext("2d");
  let dots = [];
  let mouse = { x: null, y: null };
  window.addEventListener("mousemove", (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });

  function init() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    dots = [];
    for (let i = 0; i < 40; i++) {
      dots.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.2,
        vy: (Math.random() - 0.5) * 0.2,
        size: Math.random() * 2 + 1,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#f97316";
    ctx.strokeStyle = "rgba(249, 115, 22, 0.03)";
    dots.forEach((d) => {
      d.x += d.vx; d.y += d.vy;
      if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
      if (d.y < 0 || d.y > canvas.height) d.vy *= -1;

      let dist = Math.hypot(mouse.x - d.x, mouse.y - d.y);
      if (dist < 200) {
        ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
      }
      ctx.beginPath(); ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2); ctx.fill();
    });
    requestAnimationFrame(draw);
  }
  init(); draw();
  window.addEventListener("resize", init);

  // ២. Logic Update Preview
  function updatePreview(url) {
    const preview = document.getElementById("avatarPreview");
    if (url && url.trim() !== "") {
      preview.src = url;
      preview.onerror = () => {
        preview.src = "https://api.dicebear.com/7.x/bottts/svg?seed=fallback";
      };
    }
  }

  // ៣. Logic Delete Account
  function confirmDelete() {
    Swal.fire({
      title: "ប្រយ័ត្នបងប្រូ!",
      text: "តើប្អូនប្រាកដទេថាចង់លុបគណនីចោល? រាល់ទិន្នន័យនឹងបាត់ជារៀងរហូត!",
      icon: "warning",
      background: "#1e293b",
      color: "#fff",
      showCancelButton: true,
      confirmButtonColor: "#ef4444",
      cancelButtonText: "ទុកសិនបង!",
      confirmButtonText: "លុបវាចោលទៅ!",
    }).then(async (result) => {
      if (result.isConfirmed) {
        try {
          const res = await fetch("/user/delete-account", { method: "POST" });
          if (res.ok) {
            window.location.href = "/login";
          }
        } catch (err) {
          showError("មានបញ្ហាក្នុងការលុបគណនី!");
        }
      }
    });
  }

  // ៤. Logic Submit Form
  document.getElementById("profileForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = document.getElementById("submitBtn");
    btn.disabled = true;
    btn.innerText = "កំពុងរក្សាទុក...";

    const data = {
      displayName: document.getElementById("displayName").value,
      photoURL: document.getElementById("photoURL").value,
    };

    try {
      const res = await fetch("/user/update-profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const result = await res.json();
      if (result.status === "success") {
        Swal.fire({
          icon: "success",
          title: "រួចរាល់!",
          text: "ព័ត៌មានរបស់ប្អូនត្រូវបានអាប់ដេត!",
          background: "#1e293b",
          color: "#fff",
          confirmButtonColor: "#f97316",
        });
      }
    } catch (error) {
      showError("ការអាប់ដេតបរាជ័យ!");
    } finally {
      btn.disabled = false;
      btn.innerText = "រក្សាទុកការផ្លាស់ប្តូរ";
    }
  });

  function showError(msg) {
    Swal.fire({
      icon: "error",
      title: "អូហូ!",
      text: msg,
      background: "#1e293b",
      color: "#fff",
    });
  }
</script>